<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="..\CalculosTrabalhistasTributarios.Application\CalculosTrabalhistasTributarios.Application.csproj" />
    <!-- Mesma implementação do desktop, sem referência ao assembly WPF. -->
    <Compile Include="..\CalculosTrabalhistasTributarios\Presentation\LeituraNumerica.cs" Link="Comum\LeituraNumerica.cs" />
    <Compile Include="..\CalculosTrabalhistasTributarios\Presentation\ViewModels\LeituraDeHoras.cs" Link="Comum\LeituraDeHoras.cs" />
    <Compile Include="..\CalculosTrabalhistasTributarios\Presentation\ViewModels\Historico\ComparacaoResultados.cs" Link="Historico\ComparacaoResultados.cs" />
    <Compile Include="..\CalculosTrabalhistasTributarios\Presentation\ViewModels\Historico\LinhaResultadoComparadoViewModel.cs" Link="Historico\LinhaResultadoComparadoViewModel.cs" />
    <Compile Include="..\CalculosTrabalhistasTributarios\Presentation\SecoesDoManual.cs" Link="Ajuda\SecoesDoManual.cs" />
    <!-- Erros de preenchimento no mesmo padrão do desktop: leitura, orientação curta e campos citados pelas regras. -->
    <Compile Include="..\CalculosTrabalhistasTributarios\Presentation\Mvvm\ViewModelBase.cs" Link="Comum\ViewModelBase.cs" />
    <Compile Include="..\CalculosTrabalhistasTributarios\Presentation\ViewModels\ErrosDoFormulario.cs" Link="Comum\ErrosDoFormulario.cs" />
    <Compile Include="..\CalculosTrabalhistasTributarios\Presentation\ViewModels\Calculadoras\CamposCitadosPorRotulo.cs" Link="Comum\CamposCitadosPorRotulo.cs" />
    <EmbeddedResource Include="Exemplos\*.json" LogicalName="Exemplos.%(Filename)%(Extension)" />
    <!-- A ajuda de cada calculadora mostra a seção do manual dentro do aplicativo. -->
    <EmbeddedResource Include="..\docs\MANUAL.md" LogicalName="Manual.MANUAL.md" />
    <!-- Termos, licença, responsabilidade e privacidade: mesmo leitor e mesmos arquivos do desktop. -->
    <Compile Include="..\CalculosTrabalhistasTributarios\Presentation\Documentos\*.cs" Link="Documentos\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\docs\legal\*.md" LogicalName="DocumentosLegais.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="DocumentosLegais.LICENSE" />
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.md" LogicalName="DocumentosLegais.THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
