<Window x:Class="CalculosTrabalhistasTributarios.Views.CaixaMensagemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MinWidth="400" MaxWidth="600" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="AoCopiar" />
    </Window.CommandBindings>
    <Grid Margin="24,22,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="Icone" Width="36" Height="36" CornerRadius="18" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,0,16,0">
            <TextBlock x:Name="Simbolo" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="Texto" Grid.Column="1" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center" Margin="0,4,0,0" />
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="Sim" Content="Sim" MinWidth="100" Margin="0,0,8,0" Click="AoConfirmar" Visibility="Collapsed" AutomationProperties.Name="Sim" />
            <Button x:Name="Ok" Style="{StaticResource PrimaryButton}" Content="OK" MinWidth="100" IsDefault="True" IsCancel="True" Click="AoFechar" AutomationProperties.Name="OK" />
        </StackPanel>
    </Grid>
</Window>
