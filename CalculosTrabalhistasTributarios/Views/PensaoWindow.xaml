<Window x:Class="CalculosTrabalhistasTributarios.Views.PensaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:CalculosTrabalhistasTributarios.Presentation.Behaviors"
        Title="Cálculo de pensão alimentícia" Height="900" Width="1180" MinHeight="640" MinWidth="900"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner">
    <!-- A janela inteira rola quando falta altura, por exemplo com vários beneficiários ou numa tela menor, para o resultado
         não ficar espremido abaixo do formulário. -->
    <ScrollViewer x:Name="Pagina" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" behaviors:RolagemDaTela.Ativa="True">
        <!-- Com pouco conteúdo, a página ocupa a janela e o cartão do resultado estica até o fim dela. -->
        <Border Padding="28" MinHeight="{Binding ViewportHeight, ElementName=Pagina}" Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Cálculo de pensão alimentícia" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Style="{StaticResource BotaoAjuda}" /><Button Content="Preencher exemplo" Style="{StaticResource LinkButton}" Command="{Binding Historico.PreencherExemploCommand}" Margin="16,2,0,0" VerticalAlignment="Center" Visibility="{Binding Historico.TemExemplo, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Preenche o formulário com os dados fictícios do exemplo do manual e calcula, para conhecer os campos." /></StackPanel>
                    <TextBlock Text="Pensão e IRRF nos modelos normal e simplificado. A pensão é deduzida do IRRF somente nas deduções legais." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24,24,24,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <!-- 1ª linha: os rendimentos de quem paga, que definem o INSS e o IRRF; depois, a pensão de cada beneficiário. -->
                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Competência" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" behaviors:MascaraData.Tipo="Competencia" TextAlignment="Center" AutomationProperties.Name="Competência" ToolTip="Mês e ano das tabelas de INSS, IRRF e salário mínimo (MM/AAAA)." /><TextBlock Text="{Binding [Competencia]}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,14"><TextBlock Text="Valor bruto" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding ValorBruto, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Valor bruto" ToolTip="Rendimentos tributáveis do mês de quem paga a pensão." /><TextBlock Text="{Binding [ValorBruto]}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,14"><TextBlock Text="Base de INSS" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox IsReadOnly="{Binding UsarBrutoComoBaseInss}" Text="{Binding BaseInss, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Base de INSS" ToolTip="Acompanha o valor bruto; altere só se a base de contribuição for diferente." /><TextBlock Text="{Binding [BaseInss]}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,12,14"><TextBlock Text="Dependentes" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Dependentes, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" TextAlignment="Right" behaviors:FormatacaoNumerica.ValorVazio="0" AutomationProperties.Name="Dependentes" ToolTip="Dependentes para a dedução do IRRF, sem os beneficiários da pensão." /><TextBlock Text="{Binding [Dependentes]}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,0,14"><TextBlock Text="Abatimentos (R$)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding OutrosDescontos, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Abatimentos dos rendimentos" ToolTip="Valores que não são rendimento tributável, como faltas e atrasos: saem dos rendimentos, da base do IRRF e da base da pensão. Consignados e plano de saúde não entram aqui, porque não reduzem o IRRF." /><TextBlock Text="{Binding [OutrosDescontos]}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,0,0,16">
                            <CheckBox Foreground="{DynamicResource TextBrush}" Content="Usar o valor bruto como base de INSS" IsChecked="{Binding UsarBrutoComoBaseInss}" AutomationProperties.Name="Usar o valor bruto como base de INSS" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Text="Abatimentos (opcional): valores que reduzem os rendimentos, o IRRF e a base da pensão, como faltas e atrasos. Não inclua consignados nem plano de saúde. Valores monetários: até 999.999.999,99, com duas casas decimais." />
                        </StackPanel>
                        <!-- Uma linha por beneficiário, com as mesmas colunas da linha dos rendimentos. A lista mostra até duas linhas e rola
                             a partir da terceira, para o formulário não tomar o espaço do resultado. -->
                        <ScrollViewer x:Name="ListaBeneficiarios" Grid.Row="2" Grid.ColumnSpan="5" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Beneficiarios}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1.6*" /><ColumnDefinition /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Beneficiário" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do beneficiário" ToolTip="Nome de quem recebe a pensão, usado no resultado e no relatório." /></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,14" ToolTip="Sobre o que a pensão incide, conforme a decisão judicial ou o acordo.">
                                            <TextBlock Text="Base da pensão" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding BasesPensao}" SelectedItem="{Binding BaseSelecionada, Mode=TwoWay}" MinHeight="54" AutomationProperties.Name="Base da pensão">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Texto}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,12,14" Visibility="{Binding EhPercentual, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Percentual da pensão" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Percentual, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Percentual da pensão" ToolTip="Percentual definido em decisão ou acordo: de 0 a 100 sobre os rendimentos e até 1.000 sobre o salário mínimo (150 para 1,5 salário mínimo)." /><TextBlock Text="{Binding [Percentual]}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,12,14" Visibility="{Binding EhValorFixo, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Valor da pensão" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding ValorPensao, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Valor da pensão" ToolTip="Valor mensal fixado em decisão ou acordo." /><TextBlock Text="{Binding [ValorPensao]}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" /></StackPanel>
                                        <!-- Só leitura: vem da tabela de salário mínimo e acompanha a competência. -->
                                        <StackPanel Grid.Column="3" Margin="0,0,12,14" Visibility="{Binding EhSalarioMinimo, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Salário mínimo vigente na competência, da tabela Salário mínimo. É atualizado ao mudar a competência.">
                                            <TextBlock Text="{Binding RotuloSalarioMinimo}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding SalarioMinimo, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" TextAlignment="Right" Background="{DynamicResource ResultBackgroundBrush}" AutomationProperties.Name="Salário mínimo" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="↑" ToolTip="Subir beneficiário" AutomationProperties.Name="Subir beneficiário" Command="{Binding DataContext.SubirBeneficiarioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <Button Content="↓" ToolTip="Descer beneficiário" AutomationProperties.Name="Descer beneficiário" Command="{Binding DataContext.DescerBeneficiarioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <Button Style="{StaticResource LinkButton}" Content="Remover" ToolTip="Remover beneficiário" AutomationProperties.Name="Remover beneficiário" Command="{Binding DataContext.RemoverBeneficiarioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Row="3" Style="{StaticResource LinkButton}" Content="+ Adicionar beneficiário" Command="{Binding AdicionarBeneficiarioCommand}" VerticalAlignment="Bottom" Margin="0,0,12,24" ToolTip="Inclui outra pensão, por exemplo de outro filho, com a sua própria regra." />
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,12,14" Visibility="{Binding TemVariosBeneficiarios, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Mesma base: cada pensão incide sobre os rendimentos inteiros. Após as anteriores: a base de cada pensão é reduzida pelas pensões que vêm antes dela na lista.">
                            <TextBlock Text="Ordem de cálculo" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding OpcoesOrdem}" SelectedItem="{Binding OrdemSelecionada, Mode=TwoWay}" MinHeight="54" AutomationProperties.Name="Ordem de cálculo">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Texto}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,14">
                            <CheckBox Foreground="{DynamicResource TextBrush}" Content="Exibir memória detalhada" IsChecked="{Binding ExibirMemoriaDetalhada}" Margin="0,0,0,10" AutomationProperties.Name="Exibir memória detalhada" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Calcular" MinWidth="112" Command="{Binding CalcularCommand}" IsDefault="True" AutomationProperties.Name="Calcular pensão alimentícia" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="4" Style="{StaticResource Card}" MinHeight="260">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Resultado da simulação" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Historico.Situacao}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding Historico.TemSituacao, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Salvar no histórico" Command="{Binding Historico.SalvarCommand}" MinWidth="150" Margin="0,0,8,0" ToolTip="Guarda o formulário com um nome, para reabrir, refazer com outros valores ou duplicar o cálculo pela aba Histórico da tela principal." />
                                <Button Content="Gerar Excel" Command="{Binding ExportarExcelCommand}" MinWidth="112" Margin="0,0,8,0" ToolTip="Salva o resultado em uma planilha do Excel (.xlsx), com os valores como números para somar e refazer as contas." />
                                <Button Style="{StaticResource PrimaryButton}" Content="Gerar PDF" Command="{Binding ExportarPdfCommand}" MinWidth="112" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource EstadoVazio}" Text="Informe os dados e selecione Calcular. Marque Exibir memória detalhada para conferir as iterações." />
                        <StackPanel Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding TemResultado, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Padding="14,12" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Como a pensão foi calculada" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Explicacao}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Dados alterados: recalcule antes de usar ou exportar o resultado." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding ResultadoDesatualizado, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Resumo executivo" FontSize="15" FontWeight="SemiBold" />
                            <!-- Três colunas preservam a leitura dos valores na largura mínima. -->
                            <ItemsControl ItemsSource="{Binding IndicadoresResumo}" Margin="0,10,0,20">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,10,10" Padding="14" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="{Binding Rotulo}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Valor}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Complemento}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,20"
                                    Visibility="{Binding TemPensoesPorBeneficiario, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
                                <TextBlock Text="Pensão por beneficiário" FontSize="15" FontWeight="SemiBold" />
                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Beneficiário" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Regra" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="Pensão" FontWeight="SemiBold" /></Grid>
                                <ItemsControl ItemsSource="{Binding PensoesPorBeneficiario}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="{Binding Nome}" /><TextBlock Grid.Column="1" Text="{Binding Regra}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Grid.Column="2" Text="{Binding Pensao}" FontWeight="SemiBold" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel></Border>
                            <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,20"><StackPanel>
                                <TextBlock Text="Comparação entre modalidades" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="A modalidade aplicada usa o menor IRRF e determina os valores do resumo." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" />
                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Modalidade" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Faixa do IRRF" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="IRRF final" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="Pensão" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="IRRF + pensão" FontWeight="SemiBold" /></Grid>
                                <ItemsControl ItemsSource="{Binding ComparativoPensao}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="{Binding Modalidade}" /><TextBlock Grid.Column="1" Text="{Binding FaixaIrrf}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0" /><TextBlock Grid.Column="2" Text="{Binding IrrfFinal}" /><TextBlock Grid.Column="3" Text="{Binding Pensao}" /><TextBlock Grid.Column="4" Text="{Binding Total}" FontWeight="SemiBold" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel></Border>
                            <TextBlock Text="Memória de cálculo" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MensagemMemoria}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,10" />
                            <!-- O INSS é o mesmo nas duas modalidades: uma tabela só, antes das iterações. -->
                            <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12"
                                    Visibility="{Binding TemQuadroInss, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="INSS por faixas" FontSize="14" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding QuadroInss.Valor, StringFormat='INSS: {0}'}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /></Grid>
                                <ContentControl Margin="0,12,0,0" Content="{Binding QuadroInss}" Focusable="False" IsTabStop="False" />
                            </StackPanel></Border>
                            <ItemsControl ItemsSource="{Binding MemoriaPensao}" Visibility="{Binding TemMemoria, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate><DataTemplate><Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12"><StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Destaque}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /></Grid>
                                    <ItemsControl ItemsSource="{Binding Iteracoes}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><ItemsControl ItemsSource="{Binding Formulas}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,7"><TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding Formula}" FontFamily="Cascadia Mono" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <StackPanel Visibility="{Binding TemQuadro, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="IRRF por faixas na última iteração" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,8" />
                                        <ContentControl Content="{Binding Quadro}" Focusable="False" IsTabStop="False" />
                                        <TextBlock Text="{Binding ConferenciaDoQuadro}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
