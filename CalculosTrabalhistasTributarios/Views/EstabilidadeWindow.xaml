<Window x:Class="CalculosTrabalhistasTributarios.Views.EstabilidadeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:CalculosTrabalhistasTributarios.Presentation.Behaviors"
        Title="Cálculo de estabilidade" Height="790" Width="1050" MinHeight="620" MinWidth="850"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner">
    <!-- A janela inteira rola quando falta altura, por exemplo numa tela menor ou com um resultado longo, para o resultado
         não ficar espremido abaixo do formulário. -->
    <ScrollViewer x:Name="Pagina" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" behaviors:RolagemDaTela.Ativa="True">
        <!-- Com pouco conteúdo, a página ocupa a janela e o cartão do resultado estica até o fim dela. -->
        <Border Padding="28" MinHeight="{Binding ViewportHeight, ElementName=Pagina}" Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Cálculo de estabilidade" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Apure as verbas indenizatórias do período restante de estabilidade." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width=".7*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Média remuneratória" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding MediaRemuneratoria, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Dias-base" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding DiasBase, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" behaviors:FormatacaoNumerica.ValorVazio="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Data de demissão" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Demissao, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" behaviors:MascaraData.Tipo="Data" AutomationProperties.Name="Data de demissão" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Text="Fim da estabilidade" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding FimEstabilidade, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" behaviors:MascaraData.Tipo="Data" AutomationProperties.Name="Fim da estabilidade" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,12,0">
                            <TextBlock Text="Complementos" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Complementos, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" />
                        </StackPanel>
                        <Button Grid.Column="5" Style="{StaticResource PrimaryButton}" Content="Calcular" Command="{Binding CalcularCommand}" Margin="0,25,0,0" MinWidth="118" />
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" MinHeight="260">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Resultado da apuração" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DiasRestantes}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding Historico.Situacao}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding Historico.TemSituacao, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Valores estimados" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="Salvar no histórico" Command="{Binding Historico.SalvarCommand}" MinWidth="150" Margin="0,0,8,0" ToolTip="Guarda o formulário com um nome, para reabrir, refazer com outros valores ou duplicar o cálculo pela aba Histórico da tela principal." />
                                <Button Content="Gerar Excel" Command="{Binding ExportarExcelCommand}" MinWidth="112" Margin="0,0,8,0" ToolTip="Salva o resultado em uma planilha do Excel (.xlsx), com os valores como números para somar e refazer as contas." />
                                <Button Style="{StaticResource PrimaryButton}" Content="Gerar PDF" Command="{Binding ExportarPdfCommand}" MinWidth="112" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource EstadoVazio}" Text="Informe a média remuneratória, os dias-base e as datas de demissão e de fim da estabilidade e selecione Calcular." />
                        <StackPanel Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding TemResultado, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Resumo executivo" FontSize="15" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding IndicadoresResumo}" Margin="0,10,0,20">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="220" Margin="0,0,10,10" Padding="14" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Rotulo}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding Valor}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Complemento}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Memória de cálculo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding MemoriaCalculo}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Formula}" FontFamily="Cascadia Mono" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
