<Window x:Class="CalculosTrabalhistasTributarios.Views.AberturaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cálculos Trabalhistas e Tributários" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Window.Resources>
        <!-- Barra fina e arredondada nas cores do tema; o modelo padrão do Windows não acompanha o tema escuro. -->
        <Style x:Key="BarraAbertura" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4" />
                                <!-- Sem etapas para contar, um trecho percorre a barra: há trabalho em andamento. -->
                                <Border x:Name="Faixa" Width="120" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4" Visibility="Collapsed">
                                    <Border.RenderTransform><TranslateTransform x:Name="Deslocamento" X="-120" /></Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Faixa" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="Percurso">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Deslocamento" Storyboard.TargetProperty="X" From="-120" To="560" Duration="0:0:1.4" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Percurso" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="36,32,36,28">
        <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource BrandLogoImage}" Width="56" Height="56" Stretch="Uniform" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Cálculos Trabalhistas e Tributários" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Versao, Mode=OneTime, StringFormat='Versão {0}'}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding Mensagem}" FontSize="15" FontWeight="SemiBold" Margin="0,34,0,10" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Mensagem}" />
        <ProgressBar Style="{StaticResource BarraAbertura}" Minimum="0" Maximum="{Binding Total, Mode=OneTime}" Value="{Binding Concluidas, Mode=OneWay}"
                     IsIndeterminate="{Binding Indeterminado}" AutomationProperties.Name="Andamento da atualização das tabelas" />
        <Grid Margin="0,10,0,0" MinHeight="36">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Detalhe}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="Pular" Command="{Binding PularCommand}" MinWidth="96" Margin="12,0,0,0"
                    ToolTip="Abre o aplicativo com as tabelas já cadastradas; a atualização é feita na próxima abertura."
                    Visibility="{Binding Atualizando, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Pular a atualização" />
        </Grid>
        <TextBlock Text="Os dados ficam no computador; só as páginas oficiais das tabelas são consultadas." Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
