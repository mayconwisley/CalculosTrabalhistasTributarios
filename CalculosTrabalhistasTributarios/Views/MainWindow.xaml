<Window x:Class="CalculosTrabalhistasTributarios.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cálculos Trabalhistas e Tributários" Height="780" Width="1320" MinHeight="600" MinWidth="900"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<!-- Um grupo é uma coluna de cartões; cada cartão abre a sua janela. -->
		<DataTemplate x:Key="GrupoDeAtalhos">
			<StackPanel Margin="9,0">
				<Grid Margin="2,0,0,10" Height="50">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
					<Border Grid.Column="1" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
						<TextBlock Text="{Binding Atalhos.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
					</Border>
				</Grid>
				<ItemsControl ItemsSource="{Binding Atalhos}" Focusable="False">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Style="{StaticResource Atalho}" Command="{Binding Abrir}" AutomationProperties.Name="{Binding Titulo}" Margin="0,0,0,10">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
										<TextBlock Text="{Binding Descricao}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
									</StackPanel>
									<TextBlock Grid.Column="1" Text="›" FontSize="22" FontWeight="Normal" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,2" />
								</Grid>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</DataTemplate>
		<ItemsPanelTemplate x:Key="ColunasDeGrupos">
			<UniformGrid Rows="1" />
		</ItemsPanelTemplate>
	</Window.Resources>
	<Grid Margin="28" Background="{DynamicResource ApplicationBackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Orientation="Horizontal">
				<Image Source="{DynamicResource BrandLogoImage}" Width="52" Height="52" Stretch="Uniform" Margin="0,0,14,0" />
				<StackPanel VerticalAlignment="Center">
					<TextBlock Text="Central de simulações de cálculos" FontSize="28" FontWeight="SemiBold" />
					<TextBlock Text="Escolha uma calculadora para simular ou consulte as tabelas usadas nos cálculos." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
				</StackPanel>
			</StackPanel>
			<TextBlock Grid.Column="1" Text="Imposto • Brasil" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
			<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
				<TextBlock Text="Tema" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
				<ComboBox Width="128" ItemsSource="{Binding Temas}" SelectedItem="{Binding TemaSelecionado, Mode=TwoWay}">
					<ComboBox.ItemTemplate>
						<DataTemplate><TextBlock Text="{Binding Converter={StaticResource NomeTemaConverter}}" /></DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<Button Content="Manual do usuário" Command="ApplicationCommands.Help" ToolTip="Abrir o manual do usuário (F1)" MinHeight="38" Padding="14,7" Margin="12,0,0,0" />
			</StackPanel>
		</Grid>

		<!-- Avisos da abertura: versão nova e tabelas do ano não cadastradas. Sem avisos, fica só o espaçamento. -->
		<ItemsControl Grid.Row="1" ItemsSource="{Binding Avisos}" Margin="0,20,0,0" Focusable="False">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,14">
						<Grid>
							<Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
							<TextBlock Text="{Binding Texto}" TextWrapping="Wrap" VerticalAlignment="Center" />
							<Button Grid.Column="1" Content="{Binding TextoLink}" Command="{Binding AbrirLink}" Style="{StaticResource LinkButton}" Margin="16,0,0,0" VerticalAlignment="Center"
									Visibility="{Binding TemLink, Converter={StaticResource BooleanToVisibilityConverter}}" />
							<Button Grid.Column="2" Content="{Binding TextoAcao}" Command="{Binding Acao}" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="16,0,0,0" VerticalAlignment="Center" />
							<Button Grid.Column="3" Content="Dispensar" Command="{Binding Dispensar}" Style="{StaticResource LinkButton}" Margin="14,0,0,0" VerticalAlignment="Center" />
						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Border Grid.Row="2" Style="{StaticResource Card}" Padding="24,20,12,14">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Grid Margin="0,0,12,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Border Width="420" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="3">
						<UniformGrid Rows="1">
							<RadioButton x:Name="AbaCalculadoras" Style="{StaticResource AbaSegmentada}" Content="Calculadoras" GroupName="Inicio" IsChecked="True" ToolTip="Cada calculadora abre com a competência, o salário e os dependentes do último cálculo." />
							<RadioButton x:Name="AbaTabelas" Style="{StaticResource AbaSegmentada}" Content="Tabelas" GroupName="Inicio" />
							<!-- O histórico é lido de novo a cada vez que a aba fica ativa, pelo mouse ou pelo teclado, com os cálculos salvos nas outras janelas. -->
							<RadioButton x:Name="AbaHistorico" Style="{StaticResource AbaSegmentada}" Content="Histórico" GroupName="Inicio" IsChecked="{Binding HistoricoAberto, Mode=TwoWay}" />
						</UniformGrid>
					</Border>
					<Border Grid.Column="1" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0"
					        Visibility="{Binding IsChecked, ElementName=AbaCalculadoras, Converter={StaticResource BooleanToVisibilityConverter}}">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="{Binding QuantidadeCalculadoras}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
							<TextBlock Text="calculadoras disponíveis" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
						</StackPanel>
					</Border>
					<TextBlock Grid.Column="1" Text="As tabelas valem a partir da competência de cada registro e podem ser atualizadas pela internet." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0"
					           Visibility="{Binding IsChecked, ElementName=AbaTabelas, Converter={StaticResource BooleanToVisibilityConverter}}" />
					<TextBlock Grid.Column="1" Text="Os cálculos salvos ficam neste computador e reabrem com os valores do formulário, já calculados." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0"
					           Visibility="{Binding IsChecked, ElementName=AbaHistorico, Converter={StaticResource BooleanToVisibilityConverter}}" />
				</Grid>
				<ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<Grid Margin="-9,0,0,0">
						<ItemsControl ItemsSource="{Binding Calculadoras}" ItemTemplate="{StaticResource GrupoDeAtalhos}" ItemsPanel="{StaticResource ColunasDeGrupos}" Focusable="False"
						              Visibility="{Binding IsChecked, ElementName=AbaCalculadoras, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<ItemsControl ItemsSource="{Binding Tabelas}" ItemTemplate="{StaticResource GrupoDeAtalhos}" ItemsPanel="{StaticResource ColunasDeGrupos}" Focusable="False"
						              Visibility="{Binding IsChecked, ElementName=AbaTabelas, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<!-- Histórico: busca, lista dos cálculos salvos e as ações de cada um. -->
						<StackPanel Margin="9,0,12,0" Visibility="{Binding IsChecked, ElementName=AbaHistorico, Converter={StaticResource BooleanToVisibilityConverter}}">
							<Grid Margin="0,0,0,14">
								<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Text="Procurar" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
									<TextBox Width="380" Text="{Binding Historico.Filtro, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Procurar no histórico" ToolTip="Procura pelo nome do cálculo ou pela calculadora, sem diferenciar maiúsculas e acentos." />
								</StackPanel>
								<TextBlock Grid.Column="1" Text="{Binding Historico.Resumo}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,10" />
							</Grid>
							<TextBlock Text="{Binding Historico.MensagemVazia}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,8,0,0">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Style.Triggers>
											<DataTrigger Binding="{Binding Historico.TemItens}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
							<ItemsControl ItemsSource="{Binding Historico.Itens}" Focusable="False">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Padding="16,12" Margin="0,0,0,10" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
											<Grid>
												<Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
												<StackPanel VerticalAlignment="Center">
													<TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
													<TextBlock Text="{Binding Detalhe}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
												</StackPanel>
												<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
													<Button Content="Excluir" Style="{StaticResource LinkButton}" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Nome, StringFormat='Excluir {0}'}"
													        Command="{Binding DataContext.Historico.ExcluirCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
													<Button Content="Renomear" MinWidth="104" Margin="0,0,8,0" AutomationProperties.Name="{Binding Nome, StringFormat='Renomear {0}'}"
													        Command="{Binding DataContext.Historico.RenomearCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
													<Button Content="Duplicar" MinWidth="104" Margin="0,0,8,0" ToolTip="Cria uma cópia com o nome seguido de (cópia), para refazer o cálculo com outros valores sem perder o original." AutomationProperties.Name="{Binding Nome, StringFormat='Duplicar {0}'}"
													        Command="{Binding DataContext.Historico.DuplicarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
													<Button Content="Abrir" Style="{StaticResource PrimaryButton}" MinWidth="104" AutomationProperties.Name="{Binding Nome, StringFormat='Abrir {0}'}"
													        Command="{Binding DataContext.Historico.AbrirCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Grid>
				</ScrollViewer>
			</Grid>
		</Border>

		<CheckBox Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,18,0,0" IsChecked="{Binding VerificarNovasVersoes}"
				Content="Avisar sobre novas versões" Foreground="{DynamicResource MutedTextBrush}"
				ToolTip="Ao abrir, consulta no GitHub se há uma versão mais nova. Nenhum dado dos cálculos é enviado." />
		<TextBlock Grid.Row="3" Foreground="{DynamicResource MutedTextBrush}" Margin="2,18,0,0">
			<Run Text="{Binding Versao, Mode=OneTime, StringFormat='Cálculos Trabalhistas e Tributários {0}'}" />
			<Run Text=" • Dados processados localmente - Desenvolvido por: Maycon Wisley" />
			<Run Text=" • " />
			<Hyperlink
				NavigateUri="https://github.com/mayconwisley/CalculosTrabalhistasTributarios"
				RequestNavigate="Hyperlink_RequestNavigate"
				Foreground="{DynamicResource AccentBrush}">
				Projeto no Github
			</Hyperlink>
		</TextBlock>
	</Grid>
</Window>
