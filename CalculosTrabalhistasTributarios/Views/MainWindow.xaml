<Window x:Class="CalculosTrabalhistasTributarios.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cálculos Trabalhistas e Tributários" Height="780" Width="1320" MinHeight="600" MinWidth="900"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<!-- Estrela do cartão: um botão à parte, sobre o canto do cartão, para não aninhar um botão dentro de outro. -->
		<Style x:Key="Estrela" TargetType="Button">
			<Setter Property="Width" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Fundo" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
							<TextBlock x:Name="Simbolo" Text="☆" FontSize="18" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
						</Border>
						<ControlTemplate.Triggers>
							<DataTrigger Binding="{Binding Favorito}" Value="True">
								<Setter TargetName="Simbolo" Property="Text" Value="★" />
								<Setter TargetName="Simbolo" Property="Foreground" Value="{DynamicResource AccentBrush}" />
							</DataTrigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Fundo" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
								<Setter TargetName="Simbolo" Property="Foreground" Value="{DynamicResource AccentBrush}" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Fundo" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
								<Setter TargetName="Fundo" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- Cartão: abre a janela da calculadora ou da tabela; a estrela, ao lado, marca ou desmarca a favorita. -->
		<DataTemplate x:Key="CartaoDeAtalho">
			<Grid Margin="0,0,0,10">
				<Button Style="{StaticResource Atalho}" Command="{Binding Abrir}" AutomationProperties.Name="{Binding Titulo}" ToolTip="{Binding Descricao}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition Width="30" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
							<TextBlock Text="{Binding Descricao}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
						</StackPanel>
					</Grid>
				</Button>
				<Button Style="{StaticResource Estrela}" Command="{Binding AlternarFavorito}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
				        ToolTip="{Binding DescricaoFavorito}" AutomationProperties.Name="{Binding DescricaoFavorito}" />
			</Grid>
		</DataTemplate>
		<!-- Um grupo é uma coluna de cartões; os favoritos saem do grupo e vão para a seção Favoritas. -->
		<DataTemplate x:Key="GrupoDeAtalhos">
			<StackPanel Margin="9,0">
				<Grid Margin="2,0,0,10" Height="50">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
					<Border Grid.Column="1" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
						<TextBlock Text="{Binding Atalhos.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
					</Border>
				</Grid>
				<TextBlock Text="Todos os cartões deste grupo estão nas Favoritas." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,0,0,10"
				           Visibility="{Binding TodosFavoritos, Converter={StaticResource BooleanToVisibilityConverter}}" />
				<TextBlock Text="Nenhum cartão encontrado neste grupo." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,0,0,10"
				           Visibility="{Binding SemResultado, Converter={StaticResource BooleanToVisibilityConverter}}" />
				<ItemsControl ItemsSource="{Binding Atalhos}" ItemTemplate="{StaticResource CartaoDeAtalho}" Focusable="False" />
			</StackPanel>
		</DataTemplate>
		<ItemsPanelTemplate x:Key="ColunasDeGrupos">
			<UniformGrid Rows="1" />
		</ItemsPanelTemplate>
		<!-- Uma aba de cartões: as favoritas, alinhadas às colunas dos grupos, e os grupos; ou o aviso de busca sem resultado. -->
		<DataTemplate x:Key="PainelDeAtalhos">
			<StackPanel>
				<StackPanel Margin="0,0,0,8" Visibility="{Binding TemFavoritas, Converter={StaticResource BooleanToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal" Margin="11,0,0,10">
						<TextBlock Text="★" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,1" />
						<TextBlock Text="Favoritas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
						<Border Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
							<TextBlock Text="{Binding Favoritas.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
						</Border>
					</StackPanel>
					<ItemsControl ItemsSource="{Binding Favoritas}" Focusable="False" AutomationProperties.Name="Favoritas">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate><UniformGrid Columns="{Binding Colunas}" /></ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource CartaoDeAtalho}" Margin="9,0" Focusable="False" /></DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Border Height="1" Background="{DynamicResource BorderBrush}" Margin="9,6,9,16" />
				</StackPanel>
				<TextBlock Text="{Binding MensagemSemResultado}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="11,4,0,0"
				           Visibility="{Binding SemResultado, Converter={StaticResource BooleanToVisibilityConverter}}" />
				<ItemsControl ItemsSource="{Binding Grupos}" ItemTemplate="{StaticResource GrupoDeAtalhos}" ItemsPanel="{StaticResource ColunasDeGrupos}" Focusable="False" />
			</StackPanel>
		</DataTemplate>
	</Window.Resources>
	<Grid Margin="28" Background="{DynamicResource ApplicationBackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<Image Source="{DynamicResource BrandLogoImage}" Width="52" Height="52" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center" />
				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock Text="Central de simulações de cálculos" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
					<TextBlock Text="Escolha uma calculadora para simular ou consulte as tabelas usadas nos cálculos." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
				</StackPanel>
			</Grid>
			<TextBlock Grid.Column="1" Text="Imposto • Brasil" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,20,0" />
			<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
				<TextBlock Text="Tema" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
				<ComboBox Width="128" ItemsSource="{Binding Temas}" SelectedItem="{Binding TemaSelecionado, Mode=TwoWay}">
					<ComboBox.ItemTemplate>
						<DataTemplate><TextBlock Text="{Binding Converter={StaticResource NomeTemaConverter}}" /></DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<Button Content="Manual do usuário" Command="ApplicationCommands.Help" ToolTip="Abrir o manual do usuário (F1)" MinHeight="38" Padding="14,7" Margin="12,0,0,0" />
			</StackPanel>
		</Grid>

		<!-- Avisos da abertura: versão nova e tabelas do ano não cadastradas. Sem avisos, fica só o espaçamento. -->
		<ItemsControl Grid.Row="1" ItemsSource="{Binding Avisos}" Margin="0,20,0,0" Focusable="False">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,14">
						<Grid>
							<Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
							<TextBlock Text="{Binding Texto}" TextWrapping="Wrap" VerticalAlignment="Center" />
							<Button Grid.Column="1" Content="{Binding TextoLink}" Command="{Binding AbrirLink}" Style="{StaticResource LinkButton}" Margin="16,0,0,0" VerticalAlignment="Center"
									Visibility="{Binding TemLink, Converter={StaticResource BooleanToVisibilityConverter}}" />
							<Button Grid.Column="2" Content="{Binding TextoAcao}" Command="{Binding Acao}" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="16,0,0,0" VerticalAlignment="Center" />
							<Button Grid.Column="3" Content="Dispensar" Command="{Binding Dispensar}" Style="{StaticResource LinkButton}" Margin="14,0,0,0" VerticalAlignment="Center" />
						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Border Grid.Row="2" Style="{StaticResource Card}" Padding="24,20,12,14">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Grid Margin="0,0,12,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition MinWidth="176" MaxWidth="356" />
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
						<Grid.Style>
							<Style TargetType="Grid">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsChecked, ElementName=AbaHistorico}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
								</Style.Triggers>
							</Style>
						</Grid.Style>
						<TextBox x:Name="CampoBusca" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" Padding="17,0,15,0" VerticalContentAlignment="Center"
						         AutomationProperties.Name="Procurar calculadora ou tabela" ToolTip="Procura no nome e na descrição dos cartões, sem diferenciar maiúsculas e acentos (Ctrl+F). Esc limpa." />
						<TextBlock Text="⌕" FontSize="17" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="13,0,0,2" IsHitTestVisible="False" />
						<TextBlock Text="Procurar" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding Busca}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
						<Button Content="×" Width="28" Height="28" HorizontalAlignment="Right" Margin="0,0,4,0" Click="LimparBusca_Click"
						        ToolTip="Limpar a busca" AutomationProperties.Name="Limpar a busca">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="Fundo" Background="Transparent" CornerRadius="6">
										<TextBlock Text="×" FontSize="16" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
										<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource ButtonHoverBrush}" /><Setter TargetName="Fundo" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Fundo" Property="BorderThickness" Value="1" /></Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
							<Button.Style>
								<Style TargetType="Button">
									<Setter Property="Cursor" Value="Hand" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding Busca}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>
					</Grid>
					<Border Width="360" VerticalAlignment="Center" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="3">
						<UniformGrid Rows="1">
							<RadioButton x:Name="AbaCalculadoras" Style="{StaticResource AbaSegmentada}" Content="Calculadoras" GroupName="Inicio" IsChecked="True" ToolTip="Cada calculadora abre com a competência, o salário e os dependentes do último cálculo." />
							<RadioButton x:Name="AbaTabelas" Style="{StaticResource AbaSegmentada}" Content="Tabelas" GroupName="Inicio" />
							<!-- O histórico é lido de novo a cada vez que a aba fica ativa, pelo mouse ou pelo teclado, com os cálculos salvos nas outras janelas. -->
							<RadioButton x:Name="AbaHistorico" Style="{StaticResource AbaSegmentada}" Content="Histórico" GroupName="Inicio" IsChecked="{Binding HistoricoAberto, Mode=TwoWay}" />
						</UniformGrid>
					</Border>
					<Border Grid.Column="3" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0"
					        Visibility="{Binding IsChecked, ElementName=AbaCalculadoras, Converter={StaticResource BooleanToVisibilityConverter}}">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="{Binding QuantidadeCalculadoras}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
							<TextBlock Text="calculadoras disponíveis" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
						</StackPanel>
					</Border>
					<TextBlock Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" Text="As tabelas valem a partir da competência de cada registro e podem ser atualizadas pela internet." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" MaxWidth="380" Margin="20,0,0,0"
					           Visibility="{Binding IsChecked, ElementName=AbaTabelas, Converter={StaticResource BooleanToVisibilityConverter}}" />
					<TextBlock Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" Text="Os cálculos salvos ficam neste computador e reabrem com os valores do formulário, já calculados." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" MaxWidth="380" Margin="20,0,0,0"
					           Visibility="{Binding IsChecked, ElementName=AbaHistorico, Converter={StaticResource BooleanToVisibilityConverter}}" />
				</Grid>
				<ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<Grid Margin="-9,0,0,0">
						<ContentControl Content="{Binding Calculadoras}" ContentTemplate="{StaticResource PainelDeAtalhos}" Focusable="False"
						                Visibility="{Binding IsChecked, ElementName=AbaCalculadoras, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<ContentControl Content="{Binding Tabelas}" ContentTemplate="{StaticResource PainelDeAtalhos}" Focusable="False"
						                Visibility="{Binding IsChecked, ElementName=AbaTabelas, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<!-- Histórico: busca, lista dos cálculos salvos e as ações de cada um. -->
						<StackPanel Margin="9,0,12,0" Visibility="{Binding IsChecked, ElementName=AbaHistorico, Converter={StaticResource BooleanToVisibilityConverter}}">
							<Grid Margin="0,0,0,14">
								<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Text="Procurar" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
									<TextBox Width="380" Text="{Binding Historico.Filtro, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Procurar no histórico" ToolTip="Procura pelo nome do cálculo ou pela calculadora, sem diferenciar maiúsculas e acentos." />
								</StackPanel>
								<TextBlock Grid.Column="1" Text="{Binding Historico.Resumo}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,10" />
							</Grid>
							<WrapPanel Margin="0,0,0,14">
								<StackPanel Margin="0,0,12,8">
									<TextBlock Text="Calculadora" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" />
									<ComboBox Width="230" ItemsSource="{Binding Historico.CalculadorasDisponiveis}" SelectedItem="{Binding Historico.CalculadoraSelecionada}" AutomationProperties.Name="Filtrar histórico por calculadora" />
								</StackPanel>
								<StackPanel Margin="0,0,12,8">
									<TextBlock Text="Data da alteração" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" />
									<ComboBox Width="170" ItemsSource="{Binding Historico.Periodos}" SelectedItem="{Binding Historico.PeriodoSelecionado}" AutomationProperties.Name="Filtrar histórico por data de alteração" />
								</StackPanel>
								<StackPanel Margin="0,0,12,8">
									<TextBlock Text="Ordenar por" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" />
									<ComboBox Width="160" ItemsSource="{Binding Historico.Ordens}" SelectedItem="{Binding Historico.OrdemSelecionada}" AutomationProperties.Name="Ordenar histórico" />
								</StackPanel>
							</WrapPanel>
							<WrapPanel Margin="0,0,0,14">
								<Button Content="Comparar entradas" Command="{Binding Historico.CompararCommand}" Margin="0,0,12,0" AutomationProperties.Name="Comparar entradas de dois cálculos salvos" />
								<TextBlock Text="{Binding Historico.SituacaoComparacao}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
							</WrapPanel>
							<TextBlock Text="{Binding Historico.MensagemVazia}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,8,0,0">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Style.Triggers>
											<DataTrigger Binding="{Binding Historico.TemItens}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
							<ItemsControl ItemsSource="{Binding Historico.Itens}" Focusable="False">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Padding="16,12" Margin="0,0,0,10" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
											<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
											<CheckBox IsChecked="{Binding Selecionado}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding Nome, StringFormat='Selecionar {0} para comparação'}" />
											<StackPanel Grid.Column="1" VerticalAlignment="Center">
													<TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
													<TextBlock Text="{Binding Detalhe}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
												</StackPanel>
											<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
													<Button Content="Excluir" Style="{StaticResource LinkButton}" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Nome, StringFormat='Excluir {0}'}"
													        Command="{Binding DataContext.Historico.ExcluirCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
													<Button Content="Renomear" MinWidth="104" Margin="0,0,8,0" AutomationProperties.Name="{Binding Nome, StringFormat='Renomear {0}'}"
													        Command="{Binding DataContext.Historico.RenomearCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
													<Button Content="Duplicar" MinWidth="104" Margin="0,0,8,0" ToolTip="Cria uma cópia com o nome seguido de (cópia), para refazer o cálculo com outros valores sem perder o original." AutomationProperties.Name="{Binding Nome, StringFormat='Duplicar {0}'}"
													        Command="{Binding DataContext.Historico.DuplicarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
													<Button Content="Abrir" Style="{StaticResource PrimaryButton}" MinWidth="104" AutomationProperties.Name="{Binding Nome, StringFormat='Abrir {0}'}"
													        Command="{Binding DataContext.Historico.AbrirCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Grid>
				</ScrollViewer>
			</Grid>
		</Border>

		<Grid Grid.Row="3" Margin="0,18,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<CheckBox Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,0" IsChecked="{Binding VerificarNovasVersoes}"
					Content="Avisar sobre novas versões" Foreground="{DynamicResource MutedTextBrush}"
					ToolTip="Ao abrir, consulta no GitHub se há uma versão mais nova. Nenhum dado dos cálculos é enviado." />
			<TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="2,0,0,0">
				<Run Text="{Binding Versao, Mode=OneTime, StringFormat='Cálculos Trabalhistas e Tributários {0}'}" />
				<Run Text=" • Dados processados localmente - Desenvolvido por: Maycon Wisley" />
				<Run Text=" • " />
				<Hyperlink
					NavigateUri="https://github.com/mayconwisley/CalculosTrabalhistasTributarios"
					RequestNavigate="Hyperlink_RequestNavigate"
					Foreground="{DynamicResource AccentBrush}">
					Projeto no Github
				</Hyperlink>
			</TextBlock>
		</Grid>
	</Grid>
</Window>
