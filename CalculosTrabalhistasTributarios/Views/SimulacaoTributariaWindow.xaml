<Window x:Class="CalculosTrabalhistasTributarios.Views.SimulacaoTributariaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:CalculosTrabalhistasTributarios.Presentation.Behaviors"
        Title="Simulação tributária" Height="840" Width="1180" MinHeight="620" MinWidth="900"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner">
    <!-- A janela inteira rola quando falta altura, por exemplo numa tela menor ou com um resultado longo, para o resultado
         não ficar espremido abaixo do formulário. -->
    <ScrollViewer x:Name="Pagina" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" behaviors:RolagemDaTela.Ativa="True">
        <!-- Com pouco conteúdo, a página ocupa a janela e o cartão do resultado estica até o fim dela. -->
        <Border Padding="28" MinHeight="{Binding ViewportHeight, ElementName=Pagina}" Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Simulação tributária" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="IRRF nas modalidades normal e simplificada, INSS por faixas, salário líquido e FGTS." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.45*" />
                            <ColumnDefinition Width="1.45*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Competência" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" TextAlignment="Center" AutomationProperties.Name="Competência" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="Valor bruto" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding ValorBruto, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Valor bruto" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                            <TextBlock Text="Base de INSS" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding BaseInss, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Base de INSS" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,14,0">
                            <TextBlock Text="Dependentes" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Dependentes, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.ValorVazio="0" AutomationProperties.Name="Dependentes" />
                        </StackPanel>
                        <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="Calcular" Margin="4,25,0,0" MinWidth="126" Command="{Binding CalcularCommand}" IsDefault="True" />
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" MinHeight="260">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Resultado da simulação" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Historico.Situacao}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding Historico.TemSituacao, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Salvar no histórico" Command="{Binding Historico.SalvarCommand}" MinWidth="150" Margin="0,0,8,0" ToolTip="Guarda o formulário com um nome, para reabrir, refazer com outros valores ou duplicar o cálculo pela aba Histórico da tela principal." />
                                <Button Content="Gerar Excel" Command="{Binding ExportarExcelCommand}" MinWidth="112" Margin="0,0,8,0" ToolTip="Salva o resultado em uma planilha do Excel (.xlsx), com os valores como números para somar e refazer as contas." />
                                <Button Style="{StaticResource PrimaryButton}" Content="Gerar PDF" Command="{Binding ExportarPdfCommand}" MinWidth="112" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource EstadoVazio}" Text="Preencha competência, valor bruto, base de INSS e dependentes e selecione Calcular para ver o resumo e a memória de cálculo." />
                        <StackPanel Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding TemResultado, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Resumo executivo" FontSize="15" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding IndicadoresResumo}" Margin="0,10,0,20">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="205" Margin="0,0,10,10" Padding="14" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Rotulo}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding Valor}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Complemento}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Comparação entre modalidades" FontSize="15" FontWeight="SemiBold" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Modalidade" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Base" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="Redução" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="IRRF final" FontWeight="SemiBold" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ComparativoIrrf}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,8,0,0" Padding="10,8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EhMaisVantajosa}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AdvantageBackgroundBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AdvantageBorderBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Modalidade}" VerticalAlignment="Center" />
                                                            <TextBlock Text="Mais vantajoso" Visibility="{Binding EhMaisVantajosa, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource AdvantageTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding BaseCalculo}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ReducaoMensal}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding ImpostoFinal}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Memória de cálculo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding MemoriaIrrf}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Destaque}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Formulas}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,7">
                                                                <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Formula}" FontFamily="Cascadia Mono" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding MemoriaTributaria}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=Total: {0}}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                                </Grid>
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Faixa" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="1" Text="Base" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="2" Text="Alíquota" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="3" Text="Imposto" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Linhas}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,7,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.1*" />
                                                                    <ColumnDefinition />
                                                                    <ColumnDefinition />
                                                                    <ColumnDefinition />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Faixa}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding BaseCalculada}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Aliquota}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Imposto}" FontWeight="SemiBold" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
