<Window x:Class="CalculosTrabalhistasTributarios.Views.CalculadoraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:CalculosTrabalhistasTributarios.Presentation.Behaviors"
        xmlns:calculadoras="clr-namespace:CalculosTrabalhistasTributarios.Presentation.ViewModels.Calculadoras"
        Title="{Binding Titulo}" Height="840" Width="1180" MinHeight="620" MinWidth="900"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="CamposEmLinhas"><WrapPanel /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CampoEmLarguraTotal"><Grid /></ItemsPanelTemplate>
        <!-- Cada tipo de campo tem o seu controle; a calculadora só declara os campos. -->
        <DataTemplate DataType="{x:Type calculadoras:CampoTextoViewModel}">
            <StackPanel Width="170" Margin="0,0,14,14" ToolTip="{Binding Dica}" Visibility="{Binding Visivel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Rotulo}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" TextAlignment="{Binding Alinhamento}" behaviors:MascaraData.Tipo="{Binding Mascara}" behaviors:FormatacaoNumerica.Formato="{Binding Formato}" behaviors:FormatacaoNumerica.ValorVazio="{Binding ValorVazio}" AutomationProperties.Name="{Binding Rotulo}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type calculadoras:CampoOpcaoViewModel}">
            <StackPanel Width="{Binding Largura}" Margin="0,0,14,14" ToolTip="{Binding Dica}" Visibility="{Binding Visivel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Rotulo}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                <ComboBox ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Selecionada, Mode=TwoWay}" MinHeight="54" AutomationProperties.Name="{Binding Rotulo}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Texto}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type calculadoras:CampoAtualizacaoCotacoesViewModel}">
            <StackPanel Width="354" Margin="0,0,14,14" ToolTip="{Binding Dica}">
                <TextBlock Text="{Binding Rotulo}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                <Button Content="Atualizar cotações online" Command="{Binding Comando}" HorizontalAlignment="Left" AutomationProperties.Name="Atualizar cotações online" />
                <TextBlock Text="{Binding Estado}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type calculadoras:CampoVinculosInssViewModel}">
            <StackPanel Width="650" Margin="0,0,14,14" Visibility="{Binding Visivel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Width="170" HorizontalAlignment="Left" Margin="0,0,0,18" ToolTip="{Binding Competencia.Dica}">
                    <TextBlock Text="{Binding Competencia.Rotulo}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Competencia.Valor, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" TextAlignment="Center" AutomationProperties.Name="Competência" />
                </StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Linhas.Count, StringFormat={}{0} vínculos}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                </Grid>
                <TextBlock Text="{Binding Dica}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />
                <Grid Margin="8,0,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" /><ColumnDefinition Width="160" /><ColumnDefinition Width="115" /><ColumnDefinition Width="185" /><ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nº" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="Categoria" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="Remuneração (R$)" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="Fonte (opcional)" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock Grid.Column="4" Text="Ações" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Linhas}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" /><ColumnDefinition Width="160" /><ColumnDefinition Width="115" /><ColumnDefinition Width="185" /><ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Numero, StringFormat={}{0}º}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Categoria, Mode=TwoWay}" Margin="0,0,8,0" MinHeight="42" AutomationProperties.Name="Categoria do vínculo">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Texto}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="2" Text="{Binding Remuneracao, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" Margin="0,0,8,0" VerticalContentAlignment="Center" AutomationProperties.Name="Remuneração do vínculo" />
                                    <TextBox Grid.Column="3" Text="{Binding Identificacao, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" MaxLength="120" VerticalContentAlignment="Center" AutomationProperties.Name="Fonte pagadora opcional" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="↑" Width="32" Height="32" Padding="0" Margin="0,0,4,0" IsEnabled="{Binding PodeSubir}" Command="{Binding DataContext.SubirCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Mover este vínculo para cima" AutomationProperties.Name="Mover vínculo para cima" />
                                        <Button Content="↓" Width="32" Height="32" Padding="0" Margin="0,0,4,0" IsEnabled="{Binding PodeDescer}" Command="{Binding DataContext.DescerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Mover este vínculo para baixo" AutomationProperties.Name="Mover vínculo para baixo" />
                                        <Button Content="×" Width="32" Height="32" Padding="0" IsEnabled="{Binding PodeRemover}" Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Remover este vínculo" AutomationProperties.Name="Remover vínculo" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ Adicionar vínculo" Command="{Binding AdicionarCommand}" HorizontalAlignment="Left" Padding="12,6" Margin="0,2,0,0" ToolTip="Até 50 vínculos por competência" AutomationProperties.Name="Adicionar vínculo" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type calculadoras:CampoReajusteRetroativoViewModel}">
            <StackPanel Width="650" Margin="0,0,14,14" Visibility="{Binding Visivel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="1. Gere as competências" FontWeight="SemiBold" Margin="0,0,0,8" />
                <WrapPanel Margin="0,0,0,10">
                    <StackPanel Width="145" Margin="0,0,8,8"><TextBlock Text="Início (MM/AAAA)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Inicio, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" AutomationProperties.Name="Início do reajuste" /></StackPanel>
                    <StackPanel Width="145" Margin="0,0,8,8"><TextBlock Text="Fim (MM/AAAA)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Fim, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" AutomationProperties.Name="Fim do reajuste" /></StackPanel>
                    <StackPanel Width="145" Margin="0,0,8,8"><TextBlock Text="Salário anterior (R$)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding SalarioAnterior, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Salário anterior" /></StackPanel>
                    <StackPanel Width="145" Margin="0,0,8,8"><TextBlock Text="Reajuste (%)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Percentual, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.ValorVazio="0,00" AutomationProperties.Name="Percentual de reajuste" /></StackPanel>
                </WrapPanel>
                <Button Content="Gerar meses" Command="{Binding GerarCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="Gerar competências mensais" />
                <TextBlock Text="Gerar novamente preserva os meses que continuarem no período; a exclusão de meses pede confirmação." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Mensagem}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <TextBlock Text="2. Revise o que foi pago em cada mês" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock Text="Edite os valores nos meses com antecipação, promoção, afastamento ou férias. O valor devido já inclui o reajuste informado." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <Grid Margin="8,0,8,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="195" /><ColumnDefinition Width="195" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Competência" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="Salário pago (R$)" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="Salário devido (R$)" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                </Grid>
                <ScrollViewer MaxHeight="245" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding Meses}" Focusable="False">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="195" /><ColumnDefinition Width="195" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" Margin="0,0,8,0" AutomationProperties.Name="Competência da diferença salarial" />
                                    <TextBox Grid.Column="1" Text="{Binding BasePaga, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="0,0,8,0" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Salário pago" />
                                    <TextBox Grid.Column="2" Text="{Binding BaseDevida, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Salário devido" />
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="3. Acrescente 13º ou férias já pagos, se houver" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock Text="Informe a base salarial paga e a correta. Os avos do 13º ou dias de férias e o terço são calculados aqui." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,9" />
                <ItemsControl ItemsSource="{Binding Reflexos}" Focusable="False">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TipoTexto}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Remover" Command="{Binding DataContext.RemoverReflexoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="8,4" MinHeight="28" AutomationProperties.Name="Remover lançamento" />
                                </Grid>
                                <WrapPanel>
                                    <StackPanel Width="122" Margin="0,0,7,0"><TextBlock Text="Competência" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" /><TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" AutomationProperties.Name="Competência do reflexo" /></StackPanel>
                                    <StackPanel Width="162" Margin="0,0,7,0"><TextBlock Text="Base paga (R$)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" /><TextBox Text="{Binding BasePaga, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Base salarial paga" /></StackPanel>
                                    <StackPanel Width="162" Margin="0,0,7,0"><TextBlock Text="Base correta (R$)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" /><TextBox Text="{Binding BaseDevida, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Base salarial correta" /></StackPanel>
                                    <StackPanel Width="70"><TextBlock Text="{Binding Unidade}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" /><TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.ValorVazio="0" AutomationProperties.Name="Avos ou dias" /></StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal">
                    <Button Content="+ 13º salário" Command="{Binding AdicionarDecimoTerceiroCommand}" Padding="10,6" Margin="0,0,8,0" AutomationProperties.Name="Adicionar décimo terceiro" />
                    <Button Content="+ Férias gozadas" Command="{Binding AdicionarFeriasCommand}" Padding="10,6" AutomationProperties.Name="Adicionar férias gozadas" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type calculadoras:CampoMediaVerbasVariaveisViewModel}">
            <StackPanel Width="830" Margin="0,0,14,14" Visibility="{Binding Visivel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Período da média" FontWeight="SemiBold" Margin="0,0,0,7" />
                <WrapPanel Margin="0,0,0,8">
                    <StackPanel Width="150" Margin="0,0,9,8"><TextBlock Text="Início (MM/AAAA)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Inicio, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" AutomationProperties.Name="Início da média" /></StackPanel>
                    <StackPanel Width="150" Margin="0,0,9,8"><TextBlock Text="Fim (MM/AAAA)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Fim, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" AutomationProperties.Name="Fim da média" /></StackPanel>
                    <StackPanel Width="150" Margin="0,0,9,8"><TextBlock Text="Divisor (meses)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Divisor, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.ValorVazio="0" AutomationProperties.Name="Divisor da média" /></StackPanel>
                    <Button Content="Gerar meses" Command="{Binding GerarCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" AutomationProperties.Name="Gerar meses da média" />
                </WrapPanel>
                <TextBlock Text="Gerar novamente preserva os meses que continuarem no período; a exclusão pede confirmação. Confira o divisor após mudar o período." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
                <TextBlock Text="{Binding Mensagem}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,9" />
                <TextBlock Text="Valores recebidos por competência (R$)" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock Text="Separe o DSR somente quando ele não estiver incluído em outra coluna. Use Outras apenas para verbas salariais. Se a regra exigir atualização de horas ou adicionais, ajuste os valores antes de calcular." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <Grid Margin="8,0,8,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="134" /><ColumnDefinition Width="134" /><ColumnDefinition Width="134" /><ColumnDefinition Width="134" /><ColumnDefinition Width="134" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Mês" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="Comissões" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="2" Text="DSR" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="3" Text="Horas extras" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="4" Text="Adicionais" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="5" Text="Outras" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
                <ScrollViewer MaxHeight="335" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Meses}" Focusable="False">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="134" /><ColumnDefinition Width="134" /><ColumnDefinition Width="134" /><ColumnDefinition Width="134" /><ColumnDefinition Width="134" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" Margin="0,0,7,0" AutomationProperties.Name="Competência das verbas variáveis" />
                                    <TextBox Grid.Column="1" Text="{Binding Comissoes, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="0,0,7,0" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Comissões do mês" />
                                    <TextBox Grid.Column="2" Text="{Binding Dsr, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="0,0,7,0" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="DSR do mês" />
                                    <TextBox Grid.Column="3" Text="{Binding HorasExtras, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="0,0,7,0" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Horas extras do mês" />
                                    <TextBox Grid.Column="4" Text="{Binding Adicionais, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="0,0,7,0" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Adicionais do mês" />
                                    <TextBox Grid.Column="5" Text="{Binding Outras, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Outras variáveis do mês" />
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type calculadoras:CampoParcelasRraViewModel}">
            <StackPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="0,0,0,14" Visibility="{Binding Visivel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Parcelas e meses de referência" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock Text="Informe uma linha por competência a que o pagamento se refere, com o valor tributável recebido, sem juros de mora. O ano da linha separa os anos anteriores, tributados pela tabela acumulada, do ano do pagamento. Cada mês conta um mês, e o 13º de cada ano conta mais um. Se souber só o total de um ano, lance-o em um dos meses e deixe os demais desse ano com 0,00." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,9" />
                <WrapPanel Margin="0,0,0,2">
                    <StackPanel Width="140" Margin="0,0,8,8"><TextBlock Text="Início (MM/AAAA)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Inicio, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" TextAlignment="Center" AutomationProperties.Name="Início dos meses do RRA" /></StackPanel>
                    <StackPanel Width="140" Margin="0,0,8,8"><TextBlock Text="Fim (MM/AAAA)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Fim, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" TextAlignment="Center" AutomationProperties.Name="Fim dos meses do RRA" /></StackPanel>
                    <StackPanel Width="170" Margin="0,0,8,8"><TextBlock Text="Valor por mês (R$)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding ValorMensal, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Valor sugerido para cada mês gerado" /></StackPanel>
                    <Button Content="Gerar meses" Command="{Binding GerarCommand}" Padding="12,6" Margin="0,0,8,8" VerticalAlignment="Bottom" ToolTip="Gera as competências do período com o valor por mês e preserva os valores já digitados" AutomationProperties.Name="Gerar meses do RRA" />
                    <Button Content="+ Mês" Command="{Binding AdicionarMensalCommand}" Padding="10,6" Margin="0,0,8,8" VerticalAlignment="Bottom" AutomationProperties.Name="Adicionar competência mensal ao RRA" />
                    <Button Content="+ 13º salário" Command="{Binding AdicionarDecimoTerceiroCommand}" Padding="10,6" Margin="0,0,8,8" VerticalAlignment="Bottom" AutomationProperties.Name="Adicionar 13º salário ao RRA" />
                </WrapPanel>
                <TextBlock Text="{Binding Mensagem}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <Grid Margin="8,0,8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Competência (MM/AAAA)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="Tipo" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="2" Text="Valor tributável recebido (R$)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Parcelas}" Focusable="False">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" TextAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="Competência da parcela do RRA" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Tipo, Mode=TwoWay}" Margin="0,0,8,0" MinHeight="54" AutomationProperties.Name="Tipo da parcela do RRA"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Texto}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                    <TextBox Grid.Column="2" Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="0,0,8,0" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Valor tributável da parcela do RRA" />
                                    <Button Grid.Column="3" Content="×" Padding="0" MinHeight="34" Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Remover parcela" AutomationProperties.Name="Remover parcela do RRA" />
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding Resumo}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type calculadoras:CampoDepositosFgtsViewModel}">
            <StackPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="0,0,0,14" Visibility="{Binding Visivel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Depósitos históricos do FGTS (opcional)" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock Text="Informe o valor devido em cada competência anterior ao desligamento, incluindo FGTS do 13º pago naquele mês. Com saldo do extrato, a soma serve para conferência; sem extrato, preencha todos os meses para estimar a multa. Valores nominais não incluem atualização monetária ou juros." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,9" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Gerar competências" Command="{Binding GerarCommand}" Padding="10,6" Margin="0,0,8,0" ToolTip="Gera meses da admissão até o mês anterior ao desligamento e preserva valores desses meses" AutomationProperties.Name="Gerar competências do FGTS" />
                    <Button Content="+ Depósito" Command="{Binding AdicionarCommand}" Padding="10,6" AutomationProperties.Name="Adicionar depósito do FGTS" />
                </StackPanel>
                <TextBlock Text="{Binding Mensagem}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <Grid Margin="8,0,8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Competência (MM/AAAA)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="Depósito devido (R$)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
                <ScrollViewer MaxHeight="255" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Depositos}" Focusable="False">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Competencia" Margin="0,0,8,0" AutomationProperties.Name="Competência do depósito do FGTS" />
                                    <TextBox Grid.Column="1" Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="0,0,8,0" behaviors:FormatacaoNumerica.Formato="N2" AutomationProperties.Name="Valor do depósito do FGTS" />
                                    <Button Grid.Column="2" Content="×" Padding="0" MinHeight="34" Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Remover depósito" AutomationProperties.Name="Remover depósito do FGTS" />
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type calculadoras:CampoQuitacaoBancoHorasViewModel}">
            <StackPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="0,0,0,14" Visibility="{Binding Visivel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Quitação transferida do banco de horas" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Descartar transferência" Command="{Binding DescartarCommand}" Padding="9,5" ToolTip="Retira as parcelas transferidas deste formulário" AutomationProperties.Name="Descartar quitação do banco de horas" />
                </Grid>
                <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <Run Text="Ciclo encerrado em " /><Run Text="{Binding FimCiclo, Mode=OneWay}" /><Run Text=" • salário usado " /><Run Text="{Binding SalarioReferencia, Mode=OneWay}" /><Run Text=" • divisor " /><Run Text="{Binding Divisor, Mode=OneWay}" /><Run Text=". Confira se a remuneração é a aplicável à quitação." />
                </TextBlock>
                <TextBlock Text="Cada parcela integra INSS, IRRF e FGTS. O banco não calculou DSR nem reflexos; confira a norma coletiva. Não repita estes valores nas horas extras ou nos outros proventos." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,9" />
                <ItemsControl ItemsSource="{Binding Parcelas}" Focusable="False">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,6">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="115" /><ColumnDefinition Width="135" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Adicional}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Horas}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Valor}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Incidencias}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding TotalTexto}" FontWeight="SemiBold" Margin="0,2,0,7" />
                <CheckBox IsChecked="{Binding Confirmado, Mode=TwoWay}" Content="Conferi as incidências e os valores; incluir estas parcelas no cálculo" AutomationProperties.Name="Confirmar incidências e valores do banco de horas" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type calculadoras:CampoBancoHorasViewModel}">
            <StackPanel Margin="0,0,0,4" Visibility="{Binding Visivel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Ciclo de compensação" FontWeight="SemiBold" Margin="0,0,0,7" />
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="Início (dd/mm/aaaa)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Inicio, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Data" AutomationProperties.Name="Início do ciclo" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Fim (dd/mm/aaaa)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Fim, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Data" AutomationProperties.Name="Fim do ciclo" /></StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="Regime" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding OpcoesRegime}" SelectedItem="{Binding Regime, Mode=TwoWay}" MinHeight="54" AutomationProperties.Name="Regime do banco de horas"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Texto}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Situação" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding OpcoesSituacao}" SelectedItem="{Binding Situacao, Mode=TwoWay}" MinHeight="54" AutomationProperties.Name="Situação do banco de horas"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Texto}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="Salário atual (R$)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Salario, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" ToolTip="Opcional no acompanhamento; obrigatório para calcular a quitação no fechamento ou na rescisão." AutomationProperties.Name="Salário para quitação" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Divisor de horas" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Divisor, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.ValorVazio="0" AutomationProperties.Name="Divisor de horas" /></StackPanel>
                        <StackPanel Grid.Column="4" ToolTip="Padrão para créditos sem adicional próprio."><TextBlock Text="Adicional padrão (%)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding Adicional, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.ValorVazio="0,00" AutomationProperties.Name="Adicional padrão de horas extras" /></StackPanel>
                    </Grid>
                </Grid>
                <TextBlock Text="Lançamentos do ciclo" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock Text="Crédito: horas extras destinadas ao banco. Compensação: folga ou redução. Informe horas:minutos. O adicional da linha é opcional nos créditos; vazio usa o padrão. As compensações consomem primeiro os créditos mais antigos." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <Grid Margin="8,0,8,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="210" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="65" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Data" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="Tipo" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="2" Text="Horas" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="3" Text="Adicional (%)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="4" Text="Descrição (opcional)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
                <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding Lancamentos}" Focusable="False">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="210" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="65" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Data, UpdateSourceTrigger=PropertyChanged}" behaviors:MascaraData.Tipo="Data" Margin="0,0,7,0" AutomationProperties.Name="Data do lançamento" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Tipo, Mode=TwoWay}" Margin="0,0,7,0" MinHeight="54" AutomationProperties.Name="Tipo de lançamento"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Texto}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                    <TextBox Grid.Column="2" Text="{Binding Horas, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="0,0,7,0" behaviors:FormatacaoNumerica.ValorVazio="0:00" AutomationProperties.Name="Horas do lançamento" />
                                    <TextBox Grid.Column="3" Text="{Binding Adicional, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EhCredito}" TextAlignment="Right" Margin="0,0,7,0" ToolTip="Somente para crédito; deixe vazio para o adicional padrão." AutomationProperties.Name="Adicional do crédito em percentual" />
                                    <TextBox Grid.Column="4" Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,7,0" AutomationProperties.Name="Descrição do lançamento" />
                                    <Button Grid.Column="5" Content="×" Padding="0" MinHeight="34" Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Remover lançamento" AutomationProperties.Name="Remover lançamento" />
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Content="+ Adicionar lançamento" Command="{Binding AdicionarCommand}" HorizontalAlignment="Left" Padding="10,6" AutomationProperties.Name="Adicionar lançamento ao banco" />
                <TextBlock Text="{Binding Mensagem}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="Valor" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <!-- A janela inteira rola quando falta altura, por exemplo numa tela menor ou com um resultado longo, para o resultado
         não ficar espremido abaixo do formulário. -->
    <ScrollViewer x:Name="Pagina" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" behaviors:RolagemDaTela.Ativa="True">
        <!-- Com pouco conteúdo, a página ocupa a janela e o cartão do resultado estica até o fim dela. -->
        <Border Padding="28" MinHeight="{Binding ViewportHeight, ElementName=Pagina}" Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Titulo}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Descricao}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24,24,24,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ItemsControl ItemsSource="{Binding Campos}" Focusable="False">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="ItemsPanel" Value="{StaticResource CamposEmLinhas}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsaFormularioLarguraTotal}" Value="True">
                                            <Setter Property="ItemsPanel" Value="{StaticResource CampoEmLarguraTotal}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UsaBotaoAbaixoFormulario}" Value="True">
                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                        <Button Grid.Column="1" Content="Calcular" Command="{Binding CalcularCommand}" IsDefault="True" VerticalAlignment="Bottom" MinWidth="118">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Margin" Value="0,0,0,14" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsaBotaoAbaixoFormulario}" Value="True">
                                            <Setter Property="Grid.Row" Value="1" />
                                            <Setter Property="Margin" Value="0,8,0,14" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="4" MinHeight="210">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TemResultado}" Value="False">
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Resultado" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Referencia}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding Historico.Situacao}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding Historico.TemSituacao, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Salvar no histórico" Command="{Binding Historico.SalvarCommand}" MinWidth="150" Margin="0,0,8,0" ToolTip="Guarda o formulário com um nome, para reabrir, refazer com outros valores ou duplicar o cálculo pela aba Histórico da tela principal." />
                                <Button Content="Gerar Excel" Command="{Binding ExportarExcelCommand}" MinWidth="112" Margin="0,0,8,0" ToolTip="Salva o resultado em uma planilha do Excel (.xlsx), com os valores como números para somar e refazer as contas." />
                                <Button Style="{StaticResource PrimaryButton}" Content="Gerar PDF" Command="{Binding ExportarPdfCommand}" MinWidth="112" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource EstadoVazio}" Text="{Binding InstrucaoInicial}" />
                        <StackPanel Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding TemResultado, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Usar no holerite" Command="{Binding UsarNoHoleriteCommand}" Margin="0,0,8,8" ToolTip="Abre o holerite com as parcelas de quitação para conferência" AutomationProperties.Name="Transferir quitação do banco de horas para o holerite" Visibility="{Binding PodeUsarNoHolerite, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="Usar na rescisão" Command="{Binding UsarNaRescisaoCommand}" Margin="0,0,8,8" ToolTip="Abre a rescisão com as parcelas de quitação para conferência" AutomationProperties.Name="Transferir quitação do banco de horas para a rescisão" Visibility="{Binding PodeUsarNaRescisao, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="Calcular o IR (RRA)" Command="{Binding CalcularRraCommand}" Margin="0,0,8,8" ToolTip="Abre o IR sobre rendimentos recebidos acumuladamente com as diferenças por competência" AutomationProperties.Name="Calcular o IR das diferenças como rendimentos recebidos acumuladamente" Visibility="{Binding PodeCalcularRra, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </WrapPanel>
                            <TextBlock Text="Resumo executivo" FontSize="15" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Destaques}" Margin="0,10,0,20">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="230" Margin="0,0,10,10" Padding="14" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Rotulo}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding Valor}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Complemento}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Comparação lado a lado: a descrição e um valor por coluna, como "Atual" e "Proposta". -->
                            <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,20"
                                    Visibility="{Binding TemComparativo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TituloComparativo}" FontSize="15" FontWeight="SemiBold" />
                                    <Grid Margin="0,12,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ColunasComparativo}" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Style="{StaticResource Valor}" /></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding LinhasComparativo}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="Descricao" Text="{Binding Descricao}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                        <ItemsControl x:Name="Valores" Grid.Column="1" ItemsSource="{Binding Valores}" Focusable="False">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Valor}" TextAlignment="Right" TextWrapping="Wrap" Margin="12,0,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Destaque}" Value="True">
                                                        <Setter TargetName="Descricao" Property="FontWeight" Value="SemiBold" />
                                                        <Setter TargetName="Valores" Property="TextElement.FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,20"
                                    Visibility="{Binding TemDemonstrativo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Demonstrativo" FontSize="15" FontWeight="SemiBold" />
                                    <Grid Margin="0,12,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Descrição" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="Referência" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding RotuloProventos}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Style="{StaticResource Valor}" />
                                        <TextBlock Grid.Column="3" Text="Descontos" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Style="{StaticResource Valor}" Visibility="{Binding TemDescontos, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Linhas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Referencia}" Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Provento}" Style="{StaticResource Valor}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Desconto}" Style="{StaticResource Valor}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Totais" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding TotalProventos}" FontWeight="SemiBold" Style="{StaticResource Valor}" />
                                        <TextBlock Grid.Column="3" Text="{Binding TotalDescontos}" FontWeight="SemiBold" Style="{StaticResource Valor}" />
                                    </Grid>
                                    <Border Margin="0,12,0,0" Padding="12,10" Background="{DynamicResource AdvantageBackgroundBrush}" BorderBrush="{DynamicResource AdvantageBorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RotuloResultado}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AdvantageTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Resultado}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AdvantageTextBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,20"
                                    Visibility="{Binding TemInformativos, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Valores informativos" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Não são pagos ao trabalhador." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,6" />
                                    <ItemsControl ItemsSource="{Binding Informativos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="2.6*" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Referencia}" Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Provento}" Style="{StaticResource Valor}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Memória de cálculo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Memoria}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Destaque}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Formulas}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,7">
                                                                <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Formula}" FontFamily="Cascadia Mono" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                    Visibility="{Binding TemObservacoes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Observações" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Observacoes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
