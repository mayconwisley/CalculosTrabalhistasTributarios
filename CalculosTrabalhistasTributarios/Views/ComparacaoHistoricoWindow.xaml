<Window x:Class="CalculosTrabalhistasTributarios.Views.ComparacaoHistoricoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}" Width="1040" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Comparação dos dados informados" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,8,0,15" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                   Text="O histórico guarda o formulário, não o resultado calculado. Abra cada cálculo para recalcular e conferir os totais com as tabelas atuais." />
        <CheckBox Grid.Row="2" Content="Mostrar apenas diferenças" IsChecked="{Binding SomenteDiferencas}" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}"
                  AutomationProperties.Name="Mostrar apenas diferenças entre os formulários" />
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Background="{DynamicResource ResultBackgroundBrush}" Margin="0,0,0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Campo" FontWeight="SemiBold" Margin="10" />
                <TextBlock Grid.Column="1" Text="{Binding NomePrimeiro}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="10" />
                <TextBlock Grid.Column="2" Text="{Binding NomeSegundo}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="10" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Linhas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,2" Background="{DynamicResource ResultBackgroundBrush}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Campo}" TextWrapping="Wrap" Margin="10" />
                                <TextBlock Grid.Column="1" Text="{Binding Primeiro}" TextWrapping="Wrap" Margin="10" />
                                <TextBlock Grid.Column="2" Text="{Binding Segundo}" TextWrapping="Wrap" Margin="10" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <Button Grid.Row="4" Content="Fechar" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="100" AutomationProperties.Name="Fechar comparação" />
    </Grid>
</Window>
