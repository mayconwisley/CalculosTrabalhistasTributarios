<Window x:Class="CalculosTrabalhistasTributarios.Views.JornadaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:CalculosTrabalhistasTributarios.Presentation.Behaviors"
        xmlns:vm="clr-namespace:CalculosTrabalhistasTributarios.Presentation.ViewModels"
        Title="Jornada pelo ponto" Height="920" Width="1220" MinHeight="640" MinWidth="980"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Horário editável dentro da grade, mais baixo que os campos do formulário. -->
        <Style x:Key="CampoDaGrade" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="EstadoSemDias" TargetType="TextBlock" BasedOn="{StaticResource EstadoVazio}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TemDias}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!-- A janela inteira rola quando falta altura, por exemplo numa tela menor ou com um resultado longo, para o resultado
         não ficar espremido abaixo do formulário. -->
    <ScrollViewer x:Name="Pagina" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" behaviors:RolagemDaTela.Ativa="True">
        <!-- Com pouco conteúdo, a página ocupa a janela e o cartão do resultado estica até o fim dela. -->
        <Border Padding="28" MinHeight="{Binding ViewportHeight, ElementName=Pagina}" Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Jornada pelo ponto" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Apure horas extras, noturnas, faltas, atrasos e intervalos pelas marcações de entrada e saída do mês." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24,24,24,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <!-- 1ª linha: o mês e a jornada contratual; 2ª linha: o horário padrão usado para gerar os dias e as ações. -->
                        <StackPanel Margin="0,0,12,14">
                            <TextBlock Text="Competência" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" AutomationProperties.Name="Competência" ToolTip="Mês do cartão de ponto (MM/AAAA)." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,14">
                            <TextBlock Text="Jornada de seg. a sex." Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding JornadaSemana, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" AutomationProperties.Name="Jornada de segunda a sexta" ToolTip="Horas previstas por dia de segunda a sexta, como 8:00 ou 8:48." />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,14">
                            <TextBlock Text="Jornada de sábado" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding JornadaSabado, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" AutomationProperties.Name="Jornada de sábado" ToolTip="Horas previstas no sábado; 0:00 quando o sábado é compensado durante a semana." />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Grid.ColumnSpan="2" Margin="0,0,12,14" ToolTip="Define o período noturno: urbano das 22h às 5h, com hora reduzida; rural das 21h às 5h na lavoura e das 20h às 4h na pecuária, sem redução.">
                            <TextBlock Text="Trabalho noturno" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding OpcoesNoturno}" SelectedItem="{Binding NoturnoSelecionado, Mode=TwoWay}" MinHeight="54" AutomationProperties.Name="Trabalho noturno">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Texto}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,12,14">
                            <TextBlock Text="Entrada" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Entrada1, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" AutomationProperties.Name="Entrada padrão" ToolTip="Horário padrão usado ao gerar os dias úteis; depois, ajuste os dias diferentes na grade." />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,14">
                            <TextBlock Text="Saída para o intervalo" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Saida1, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" AutomationProperties.Name="Saída para o intervalo padrão" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,14">
                            <TextBlock Text="Volta do intervalo" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Entrada2, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" AutomationProperties.Name="Volta do intervalo padrão" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,12,14">
                            <TextBlock Text="Saída" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Saida2, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" AutomationProperties.Name="Saída padrão" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,14">
                            <Button Content="Gerar dias" Margin="0,0,8,0" MinWidth="118" Command="{Binding GerarDiasCommand}" ToolTip="Monta os dias do mês com o horário padrão nos dias úteis e o domingo como descanso; marque os feriados e ajuste as marcações na grade." />
                            <Button Style="{StaticResource PrimaryButton}" Content="Apurar" MinWidth="118" Command="{Binding ApurarCommand}" IsDefault="True" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" MinHeight="260">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Marcações e apuração" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Ajuste o tipo do dia e as marcações na grade; horários depois da meia-noite continuam no mesmo dia." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,12,0"
                                           Visibility="{Binding TemDias, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{Binding Historico.Situacao}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding Historico.TemSituacao, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Salvar no histórico" Command="{Binding Historico.SalvarCommand}" MinWidth="150" Margin="0,0,8,0" ToolTip="Guarda as marcações com um nome, para reabrir pela aba Histórico da tela principal." />
                                <Button Content="Gerar Excel" Command="{Binding ExportarExcelCommand}" MinWidth="112" Margin="0,0,8,0" ToolTip="Salva os dias e os totais em uma planilha do Excel (.xlsx)." />
                                <Button Content="Usar no holerite" Command="{Binding UsarNoHoleriteCommand}" MinWidth="130" Margin="0,0,8,0" ToolTip="Abre o holerite do mês com as horas, as faltas e os atrasos apurados; informe o salário e os demais dados." />
                                <Button Style="{StaticResource PrimaryButton}" Content="Usar nas horas extras" Command="{Binding UsarNasHorasExtrasCommand}" MinWidth="160" ToolTip="Abre a calculadora de horas extras com as horas apuradas; informe o salário e os percentuais." />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource EstadoSemDias}" Text="Informe a competência, a jornada e o horário padrão e selecione Gerar dias para montar o cartão de ponto, ou Apurar para gerar e apurar direto." />
                        <StackPanel Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding TemDias, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding Indicadores}" Margin="0,0,0,10" Visibility="{Binding TemResultado, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,10,10" Padding="14" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="{Binding Rotulo}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Valor}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Complemento}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DataGrid ItemsSource="{Binding Dias}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserSortColumns="False" CanUserReorderColumns="False" CanUserAddRows="False" SelectionMode="Single" Margin="0,0,0,16" AutomationProperties.Name="Dias">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Dia" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="Dia" Text="{Binding Dia}" VerticalAlignment="Center" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Destaque}" Value="True">
                                                        <Setter TargetName="Dia" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Dia" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Tipo" Width="108">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{x:Static vm:DiaJornadaViewModel.Tipos}" SelectedItem="{Binding TipoSelecionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" Margin="0,2" AutomationProperties.Name="{Binding Dia, StringFormat='Tipo do dia {0}'}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Texto}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Prevista" Width="72">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource CampoDaGrade}" Text="{Binding Previsto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Dia, StringFormat='Jornada prevista em {0}'}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Entrada" Width="72">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource CampoDaGrade}" Text="{Binding Entrada1, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Dia, StringFormat='Entrada em {0}'}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Saída" Width="72">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource CampoDaGrade}" Text="{Binding Saida1, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Dia, StringFormat='Saída em {0}'}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Entrada" Width="72">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource CampoDaGrade}" Text="{Binding Entrada2, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Dia, StringFormat='Volta do intervalo em {0}'}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Saída" Width="72">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource CampoDaGrade}" Text="{Binding Saida2, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Dia, StringFormat='Saída final em {0}'}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Trabalhadas" Binding="{Binding Trabalhadas}" Width="1.25*" HeaderStyle="{StaticResource CabecalhoNumerico}" ElementStyle="{StaticResource CelulaNumerica}" />
                                    <DataGridTextColumn Header="Extras" Binding="{Binding Extras}" Width="1.3*" HeaderStyle="{StaticResource CabecalhoNumerico}" ElementStyle="{StaticResource CelulaNumerica}" />
                                    <DataGridTextColumn Header="Noturnas" Binding="{Binding Noturnas}" Width="*" HeaderStyle="{StaticResource CabecalhoNumerico}" ElementStyle="{StaticResource CelulaNumerica}" />
                                    <DataGridTextColumn Header="Faltas" Binding="{Binding Faltas}" Width="0.8*" HeaderStyle="{StaticResource CabecalhoNumerico}" ElementStyle="{StaticResource CelulaNumerica}" />
                                    <DataGridTextColumn Header="Intervalos suprimidos" Binding="{Binding Intervalos}" Width="2*">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="VerticalAlignment" Value="Center" /></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12"
                                    Visibility="{Binding TemResultado, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Critérios" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Criterios}">
                                        <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                    Visibility="{Binding TemObservacoes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Observações" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Observacoes}">
                                        <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
