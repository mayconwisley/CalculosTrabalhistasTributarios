<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Presentation.Trabalhista;assembly=CalculosTrabalhistasTributarios.Mobile.Presentation"
             x:Class="CalculosTrabalhistasTributarios.Mobile.Views.PaginadorLinhas" x:DataType="vm:PaginacaoLinhas" IsVisible="{Binding TemPaginas}">
    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
        <Button Text="Anteriores" Command="{Binding AnteriorCommand}" Clicked="AoNavegar" SemanticProperties.Description="Mostrar as linhas anteriores" />
        <Label Grid.Column="1" Text="{Binding Texto}" VerticalOptions="Center" HorizontalTextAlignment="Center" FontAttributes="Bold" />
        <Button Grid.Column="2" Text="Próximas" Command="{Binding ProximaCommand}" Clicked="AoNavegar" SemanticProperties.Description="Mostrar as próximas linhas" />
    </Grid>
</ContentView>
