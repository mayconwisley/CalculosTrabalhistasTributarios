<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Presentation.Trabalhista;assembly=CalculosTrabalhistasTributarios.Mobile.Presentation"
             x:Class="CalculosTrabalhistasTributarios.Mobile.Views.PaginadorLinhas" x:DataType="vm:PaginacaoLinhas" IsVisible="{Binding TemPaginas}">
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
        <Label Grid.ColumnSpan="2" Text="{Binding Texto}" HorizontalTextAlignment="Center" FontAttributes="Bold" />
        <Button Grid.Row="1" Text="Anterior" Command="{Binding AnteriorCommand}" Clicked="AoNavegar" SemanticProperties.Description="Mostrar as linhas anteriores" />
        <Button Grid.Row="1" Grid.Column="1" Text="Próxima" Command="{Binding ProximaCommand}" Clicked="AoNavegar" SemanticProperties.Description="Mostrar as próximas linhas" />
    </Grid>
</ContentView>
