<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Presentation.Trabalhista;assembly=CalculosTrabalhistasTributarios.Mobile.Presentation"
             xmlns:comportamentos="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Comportamentos"
             x:Class="CalculosTrabalhistasTributarios.Mobile.Views.BarraDesfazerView" x:DataType="vm:DesfazerRemocaoMobile" IsVisible="{Binding Visivel}">
    <Border Style="{StaticResource CaixaCampo}" Padding="12,4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Text="{Binding Texto}" VerticalOptions="Center" Style="{StaticResource TextoSecundario}" SemanticProperties.Description="{Binding Texto}" />
            <Button Grid.Column="1" Text="Desfazer" Style="{StaticResource BotaoLink}" Command="{Binding DesfazerCommand}" IsVisible="{Binding PodeDesfazer}"
                    comportamentos:RetornoTatil.Ativo="True" SemanticProperties.Description="Desfazer a remoção da linha" ToolTipProperties.Text="Devolve a linha à mesma posição" />
        </Grid>
    </Border>
</ContentView>
