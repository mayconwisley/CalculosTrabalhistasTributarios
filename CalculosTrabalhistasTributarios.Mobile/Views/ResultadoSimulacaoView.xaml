<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Views" xmlns:vm="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Presentation.Trabalhista;assembly=CalculosTrabalhistasTributarios.Mobile.Presentation" xmlns:dto="clr-namespace:CalculosTrabalhistasTributarios.Application.DTOs;assembly=CalculosTrabalhistasTributarios.Application" x:Class="CalculosTrabalhistasTributarios.Mobile.Views.ResultadoSimulacaoView" x:Name="Root" x:DataType="local:ResultadoSimulacaoView">
    <ContentView.Resources>
        <DataTemplate x:Key="LinhaDetalhe" x:DataType="vm:LinhaMemoriaMobile">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                <Label Text="{Binding Texto}" />
            </VerticalStackLayout>
        </DataTemplate>
    </ContentView.Resources>
    <Grid BindingContext="{Binding Source={x:Reference Root}}">
        <VerticalStackLayout Spacing="16" IsVisible="{Binding TemResultado}">
            <Border StrokeThickness="0" Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimariaProfunda}" Offset="0" />
                        <GradientStop Color="{StaticResource Primaria}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="10">
                    <Label Text="SEU RESULTADO" TextColor="White" FontSize="11" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding RotuloResultado}" TextColor="White" FontSize="16" />
                    <Label Text="{Binding ResultadoFormatado}" IsVisible="{Binding TemVerbas}" TextColor="White" FontSize="30" FontFamily="OpenSansSemibold" LineBreakMode="WordWrap" SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{Binding Demonstrativo.Referencia}" TextColor="White" FontSize="12" />
                </VerticalStackLayout>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Compartilhar PDF" Style="{StaticResource BotaoSecundario}" Command="{Binding CompartilharPdfCommand}" AutomationId="CompartilharPdf" SemanticProperties.Description="Gerar PDF e escolher aplicativo para compartilhar" />
                <Button Grid.Column="1" Text="Compartilhar resumo" Style="{StaticResource BotaoSecundario}" Command="{Binding CompartilharResumoCommand}" AutomationId="CompartilharResumo" SemanticProperties.Description="Compartilhar os destaques e totais em texto" />
            </Grid>
            <Label Text="Escolha WhatsApp, e-mail ou outro aplicativo instalado. O PDF inclui a memória e as premissas da simulação; o resumo leva só os destaques e os totais em texto." Style="{StaticResource TextoSecundario}" />
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Demonstrativo.Destaques}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="dto:DestaqueDto">
                        <Border Padding="18">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Rotulo}" Style="{StaticResource TextoSecundario}" />
                                <Label Text="{Binding Valor}" FontSize="21" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Complemento}" Style="{StaticResource TextoSecundario}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="Confira as premissas e os limites antes de usar esta estimativa." Style="{StaticResource TextoSecundario}" />
            <local:SecaoExpansivelView Titulo="Premissas e limites" AbertaInicialmente="True" Dados="{Binding Demonstrativo}">
                <local:SecaoExpansivelView.Modelo><DataTemplate x:DataType="local:ResultadoSimulacaoView">
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Demonstrativo.Observacoes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </DataTemplate></local:SecaoExpansivelView.Modelo>
            </local:SecaoExpansivelView>
            <local:SecaoExpansivelView Titulo="Demonstrativo" Dados="{Binding Demonstrativo}">
                <local:SecaoExpansivelView.Modelo><DataTemplate x:DataType="local:ResultadoSimulacaoView">
                    <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout IsVisible="{Binding TemComparativo}" Spacing="10">
                        <Label Text="{Binding Demonstrativo.Comparativo.Titulo}" Style="{StaticResource TituloSecao}" />
                        <local:PaginadorLinhas BindingContext="{Binding Detalhes.Comparativo}" />
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Detalhes.Comparativo.Exibidas}" BindableLayout.ItemTemplate="{StaticResource LinhaDetalhe}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding TemVerbas}" Spacing="10">
                    <Label Text="{Binding Demonstrativo.RotuloProventos}" FontAttributes="Bold" />
                    <local:PaginadorLinhas BindingContext="{Binding Detalhes.Proventos}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detalhes.Proventos.Exibidas}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:VerbaDto">
                                <VerticalStackLayout Spacing="3" Padding="0,4">
                                    <Label Text="{Binding Descricao}" />
                                    <Label Text="{Binding Referencia}" />
                                    <Label Text="{Binding Valor, StringFormat='R$ {0:N2}'}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Descontos" FontAttributes="Bold" />
                    <local:PaginadorLinhas BindingContext="{Binding Detalhes.Descontos}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detalhes.Descontos.Exibidas}" BindableLayout.EmptyView="Sem descontos informados.">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:VerbaDto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Descricao}" />
                                    <Label Text="{Binding Referencia}" />
                                    <Label Text="{Binding Valor, StringFormat='R$ {0:N2}'}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding Demonstrativo.RotuloResultado}" FontAttributes="Bold" />
                    <Label Text="{Binding Demonstrativo.Resultado, StringFormat='R$ {0:N2}'}" FontSize="24" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding TemInformativos}" Spacing="6">
                    <Label Text="Informativos (fora do resultado)" FontAttributes="Bold" />
                    <local:PaginadorLinhas BindingContext="{Binding Detalhes.Informativos}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detalhes.Informativos.Exibidas}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:VerbaDto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Descricao}" />
                                    <Label Text="{Binding Referencia}" />
                                    <Label Text="{Binding Valor, StringFormat='R$ {0:N2}'}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    </VerticalStackLayout>

                    </VerticalStackLayout>
                </DataTemplate></local:SecaoExpansivelView.Modelo>
            </local:SecaoExpansivelView>
            <local:SecaoExpansivelView Titulo="Memória de cálculo" Dados="{Binding Demonstrativo}">
                <local:SecaoExpansivelView.Modelo><DataTemplate x:DataType="local:ResultadoSimulacaoView">
                    <VerticalStackLayout Spacing="14">
                        <local:PaginadorLinhas x:Name="TopoMemoria" BindingContext="{Binding Detalhes.Memoria}" />
                        <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Detalhes.Memoria.Exibidas}" BindableLayout.ItemTemplate="{StaticResource LinhaDetalhe}" />
                        <local:PaginadorLinhas BindingContext="{Binding Detalhes.Memoria}" RolarAte="{x:Reference TopoMemoria}" />
                    </VerticalStackLayout>
                </DataTemplate></local:SecaoExpansivelView.Modelo>
            </local:SecaoExpansivelView>
        </VerticalStackLayout>
    </Grid>
</ContentView>
