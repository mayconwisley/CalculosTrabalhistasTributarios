<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>CalculosTrabalhistasTributarios.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <ApplicationTitle>Cálculos Trabalhistas e Tributários</ApplicationTitle>
    <ApplicationId>br.com.mayconwisley.calculostrabalhistastributarios</ApplicationId>
    <!-- Compilações locais: mesma versão da última tag do desktop. Na publicação, instalador\gerar-apk.ps1 usa a versão da
         tag e calcula o código do Android (maior × 10000 + menor × 100 + correção), que precisa crescer a cada versão. -->
    <ApplicationDisplayVersion>1.19.1</ApplicationDisplayVersion>
    <ApplicationVersion>11901</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mesmo logo do WPF (Assets/logo-light.png); a escala mantém a moldura dentro da máscara do ícone adaptável. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.7" Color="#F8F9FC" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#F8F9FC" BaseSize="160,160" />
    <MauiImage Include="Resources\Images\logo_claro.png" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\logo_escuro.png" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="..\LICENSE" LogicalName="LICENSE.txt" />
    <MauiAsset Include="..\CalculosTrabalhistasTributarios\BancoDados\calculoIrrf.db" LogicalName="calculoIrrf.db" />
    <MauiAsset Include="..\THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.txt" />
    <MauiAsset Include="..\docs\ManualDoUsuario.pdf" LogicalName="ManualDoUsuario.pdf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <ProjectReference Include="..\CalculosTrabalhistasTributarios.Mobile.Presentation\CalculosTrabalhistasTributarios.Mobile.Presentation.csproj" />
    <ProjectReference Include="..\CalculosTrabalhistasTributarios.Infrastructure.Local\CalculosTrabalhistasTributarios.Infrastructure.Local.csproj" />
    <ProjectReference Include="..\CalculosTrabalhistasTributarios.Infrastructure.Tabelas\CalculosTrabalhistasTributarios.Infrastructure.Tabelas.csproj" />
    <!-- Mesmo arquivo de erros do desktop, sem referenciar a infraestrutura de relatórios. -->
    <Compile Include="..\CalculosTrabalhistasTributarios.Infrastructure\Diagnostico\ArquivoRegistroDeErros.cs" Link="Services\ArquivoRegistroDeErros.cs" />
  </ItemGroup>
</Project>
