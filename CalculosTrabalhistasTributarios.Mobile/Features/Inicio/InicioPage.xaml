<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Presentation.Inicio;assembly=CalculosTrabalhistasTributarios.Mobile.Presentation"
             x:Class="CalculosTrabalhistasTributarios.Mobile.Features.Inicio.InicioPage" x:DataType="vm:InicioViewModel" Title="Calculadoras">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" MaximumWidthRequest="640">
            <Label Text="Seus cálculos,&#10;em qualquer lugar." FontSize="30" FontFamily="OpenSansSemibold" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Simulações locais, memória de cálculo e PDF para compartilhar." Style="{StaticResource TextoSecundario}" FontSize="14" />
            <Label Text="{Binding Resumo}" Style="{StaticResource TextoSecundario}" />
            <Border Style="{StaticResource CaixaCampo}"><Entry Text="{Binding Busca}" Placeholder="Buscar cálculos e tabelas" Keyboard="Text" HorizontalTextAlignment="Start" AutomationId="BuscaInicio" /></Border>
            <Label Text="{Binding MensagemSemResultado}" IsVisible="{Binding SemResultado}" />
            <Button Text="Limpar busca" Command="{Binding LimparBuscaCommand}" IsVisible="{Binding SemResultado}" />
            <Border IsVisible="{Binding TemAvisoTabelas}"><VerticalStackLayout Spacing="8"><Label Text="{Binding AvisoTabelas}" />
                <Button Text="Ver pendências" Command="{Binding VerPendenciasCommand}" /><Button Text="Dispensar" Command="{Binding DispensarAvisoTabelasCommand}" />
            </VerticalStackLayout></Border>
            <Label Text="Favoritas" Style="{StaticResource TituloSecao}" IsVisible="{Binding TemFavoritas}" />
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Favoritas.Atalhos}"><BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:AtalhoMobile"><Border><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="*,54"><Label Text="{Binding Titulo}" Style="{StaticResource TituloSecao}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{Binding IconeFavorito}" WidthRequest="54" Padding="0" SemanticProperties.Description="{Binding DescricaoFavorito}" CommandParameter="{Binding .}" Command="{Binding AlternarFavoritoCommand, Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, x:DataType=vm:InicioViewModel}" /></Grid>
                    <Label Text="{Binding Descricao}" Style="{StaticResource TextoSecundario}" />
                    <Button Text="{Binding TextoBotao}" CommandParameter="{Binding .}" Command="{Binding AbrirCommand, Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, x:DataType=vm:InicioViewModel}" />
                </VerticalStackLayout></Border></DataTemplate>
            </BindableLayout.ItemTemplate></VerticalStackLayout>
            <VerticalStackLayout Spacing="20" BindableLayout.ItemsSource="{Binding Grupos}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:GrupoAtalhosMobile">
                        <VerticalStackLayout Spacing="20" IsVisible="{Binding Visivel}">
                            <Label Text="{Binding Titulo}" Style="{StaticResource TituloSecao}" SemanticProperties.HeadingLevel="Level2" />
                            <VerticalStackLayout Spacing="20" BindableLayout.ItemsSource="{Binding Atalhos}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AtalhoMobile">
                                        <Border>
                                            <VerticalStackLayout Spacing="12">
                                                <Grid ColumnDefinitions="*,54"><Label Text="{Binding Titulo}" Style="{StaticResource TituloSecao}" VerticalOptions="Center" />
                                                    <Button Grid.Column="1" Text="{Binding IconeFavorito}" WidthRequest="54" Padding="0" SemanticProperties.Description="{Binding DescricaoFavorito}" CommandParameter="{Binding .}" Command="{Binding AlternarFavoritoCommand, Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, x:DataType=vm:InicioViewModel}" /></Grid>
                                                <Label Text="{Binding Descricao}" />
                                                <Button Text="{Binding TextoBotao}" AutomationId="{Binding IdAutomacao}" CommandParameter="{Binding .}"
                                                        Command="{Binding AbrirCommand, Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, x:DataType=vm:InicioViewModel}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="Tabelas" Style="{StaticResource TituloSecao}" SemanticProperties.HeadingLevel="Level2" />
            <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding GruposTabelas}"><BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:GrupoAtalhosMobile"><VerticalStackLayout Spacing="10" IsVisible="{Binding Visivel}">
                    <Label Text="{Binding Titulo}" Style="{StaticResource TituloSecao}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Atalhos}"><BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AtalhoMobile"><Border><VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,54"><Label Text="{Binding Titulo}" Style="{StaticResource RotuloCampo}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="{Binding IconeFavorito}" WidthRequest="54" Padding="0" SemanticProperties.Description="{Binding DescricaoFavorito}" CommandParameter="{Binding .}" Command="{Binding AlternarFavoritoCommand, Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, x:DataType=vm:InicioViewModel}" /></Grid>
                            <Label Text="{Binding Descricao}" Style="{StaticResource TextoSecundario}" />
                            <Button Text="Abrir tabela" CommandParameter="{Binding .}" Command="{Binding AbrirCommand, Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, x:DataType=vm:InicioViewModel}" />
                        </VerticalStackLayout></Border></DataTemplate>
                    </BindableLayout.ItemTemplate></VerticalStackLayout>
                </VerticalStackLayout></DataTemplate>
            </BindableLayout.ItemTemplate></VerticalStackLayout>
            <Label Text="{Binding Mensagem}" TextColor="{AppThemeBinding Light={StaticResource ErroClaro}, Dark={StaticResource ErroEscuro}}" />
            <Label Text="Valores estimados. Procure um profissional especializado para conferir os valores aplicáveis ao seu caso." Style="{StaticResource TextoSecundario}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
