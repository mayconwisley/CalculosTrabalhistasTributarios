<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comparacao="clr-namespace:CalculosTrabalhistasTributarios.Presentation.ViewModels.Historico;assembly=CalculosTrabalhistasTributarios.Mobile.Presentation"
             x:Class="CalculosTrabalhistasTributarios.Mobile.Features.Historico.ComparacaoPage" Title="Comparação">
    <ScrollView><VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="700">
        <Label Text="Comparar cálculos" FontSize="27" FontFamily="OpenSansSemibold" SemanticProperties.HeadingLevel="Level1" />
        <Label x:Name="Cabecalho" Style="{StaticResource TextoSecundario}" />
        <Label Text="Os resultados foram recalculados com as tabelas locais atuais para cada competência. Diferença = segundo menos primeiro." Style="{StaticResource TextoSecundario}" />
        <Label x:Name="Aviso" IsVisible="False" />
        <VerticalStackLayout x:Name="Linhas" Spacing="10" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
