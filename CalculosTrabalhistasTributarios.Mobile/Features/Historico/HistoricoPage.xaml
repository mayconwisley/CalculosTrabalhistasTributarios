<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:CalculosTrabalhistasTributarios.Application.DTOs;assembly=CalculosTrabalhistasTributarios.Application"
             xmlns:vm="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Presentation.Historico;assembly=CalculosTrabalhistasTributarios.Mobile.Presentation"
             x:Class="CalculosTrabalhistasTributarios.Mobile.Features.Historico.HistoricoPage" x:DataType="vm:HistoricoMobileViewModel" Title="Histórico" SafeAreaEdges="Container">
    <CollectionView Margin="16,0" SelectionMode="None" ItemsSource="{Binding Itens}">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="8" Padding="0,16,0,16">
                <Label Text="Cálculos salvos" Style="{StaticResource TituloPagina}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Formulários guardados neste aparelho. Abra para recalcular com as tabelas disponíveis." Style="{StaticResource TextoSecundario}" />
                <Border Style="{StaticResource CaixaCampo}">
                    <Entry Text="{Binding Busca}" Placeholder="Buscar no histórico" Keyboard="Text" MaxLength="100"
                           HorizontalTextAlignment="Start" FontSize="16" ClearButtonVisibility="WhileEditing" AutomationId="BuscaHistorico"
                           SemanticProperties.Description="Buscar no histórico pelo nome do cálculo ou da calculadora" />
                </Border>
                <Picker Title="Calculadora" ItemsSource="{Binding Calculadoras}" SelectedItem="{Binding Calculadora}" AutomationId="FiltroCalculadoraHistorico"
                        SemanticProperties.Description="Filtrar por calculadora" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Picker Title="Período" ItemsSource="{Binding Periodos}" SelectedIndex="{Binding Periodo}" SemanticProperties.Description="Filtrar pela data da última alteração" />
                    <Picker Grid.Column="1" Title="Ordem" ItemsSource="{Binding Ordens}" SelectedIndex="{Binding Ordem}" SemanticProperties.Description="Ordem da lista" />
                </Grid>
                <ActivityIndicator IsRunning="{Binding Carregando}" IsVisible="{Binding Carregando}" />
                <Label Text="{Binding Resumo}" Style="{StaticResource TextoSecundario}" />
                <Label Text="{Binding Mensagem}" IsVisible="{Binding TemMensagem}" Style="{StaticResource TextoErroCampo}" />
                <Button Text="Atualizar" Command="{Binding AtualizarCommand}" Style="{StaticResource BotaoSecundario}" AutomationId="AtualizarHistorico" />
                <Label Text="Comparar dois cálculos" Style="{StaticResource TituloSecao}" Margin="0,8,0,0" />
                <Label Text="{Binding Selecao}" Style="{StaticResource TextoSecundario}" />
                <Button Text="Comparar selecionados" Style="{StaticResource BotaoSecundario}" Command="{Binding CompararCommand}" AutomationId="CompararHistorico" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.EmptyView><Label Text="{Binding Vazio}" Margin="0,8" Style="{StaticResource TextoSecundario}" /></CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="dto:ResumoCalculoSalvoDto">
                <Border Margin="0,0,0,12" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Nome}" FontSize="20" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding Calculadora}" Style="{StaticResource TextoSecundario}" />
                        <Label Text="{Binding AlteradoEm, StringFormat='Atualizado em {0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource TextoSecundario}" />
                        <Button Text="Abrir" Command="{Binding AbrirCommand, Source={RelativeSource AncestorType={x:Type vm:HistoricoMobileViewModel}}, x:DataType=vm:HistoricoMobileViewModel}" CommandParameter="{Binding .}" AutomationId="AbrirHistorico" />
                        <Button Text="Selecionar / remover da comparação" LineBreakMode="WordWrap" Style="{StaticResource BotaoSecundario}" Command="{Binding SelecionarCommand, Source={RelativeSource AncestorType={x:Type vm:HistoricoMobileViewModel}}, x:DataType=vm:HistoricoMobileViewModel}" CommandParameter="{Binding .}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Duplicar" Style="{StaticResource BotaoSecundario}" Command="{Binding DuplicarCommand, Source={RelativeSource AncestorType={x:Type vm:HistoricoMobileViewModel}}, x:DataType=vm:HistoricoMobileViewModel}" CommandParameter="{Binding .}" />
                            <Button Grid.Column="1" Text="Renomear" Style="{StaticResource BotaoSecundario}" Command="{Binding RenomearCommand, Source={RelativeSource AncestorType={x:Type vm:HistoricoMobileViewModel}}, x:DataType=vm:HistoricoMobileViewModel}" CommandParameter="{Binding .}" />
                        </Grid>
                        <Button Text="Excluir" Style="{StaticResource BotaoLink}" Command="{Binding ExcluirCommand, Source={RelativeSource AncestorType={x:Type vm:HistoricoMobileViewModel}}, x:DataType=vm:HistoricoMobileViewModel}" CommandParameter="{Binding .}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.Footer>
            <VerticalStackLayout Spacing="8" Padding="0,8,0,16">
                <Label Text="{Binding ResumoPagina}" HorizontalTextAlignment="Center" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Anterior" Command="{Binding AnteriorCommand}" Style="{StaticResource BotaoSecundario}" AutomationId="PaginaAnteriorHistorico" />
                    <Button Grid.Column="1" Text="Próxima" Command="{Binding ProximaCommand}" Style="{StaticResource BotaoSecundario}" AutomationId="ProximaPaginaHistorico" />
                </Grid>
            </VerticalStackLayout>
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
