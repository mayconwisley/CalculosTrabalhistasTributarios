<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Presentation.Trabalhista;assembly=CalculosTrabalhistasTributarios.Mobile.Presentation"
             xmlns:views="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Views"
             xmlns:comportamentos="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Comportamentos"
             xmlns:trabalhista="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Features.Trabalhista"
             x:Class="CalculosTrabalhistasTributarios.Mobile.Features.Trabalhista.CalculadoraTrabalhistaPage"
             x:DataType="vm:CalculadoraTrabalhistaViewModel" Title="Calculadora trabalhista">
    <ContentPage.Resources>
        <DataTemplate x:Key="ModeloCampo" x:DataType="vm:CampoMobile"><views:CampoFormularioView /></DataTemplate>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto">
    <ScrollView x:Name="RolagemFormulario">
        <VerticalStackLayout Padding="20,18,20,28" Spacing="16" MaximumWidthRequest="640">
            <VerticalStackLayout Spacing="6">
                <Label Text="SIMULAÇÃO" Style="{StaticResource RotuloDestaque}" />
                <Label Text="{Binding Titulo}" Style="{StaticResource TituloPagina}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding Descricao}" Style="{StaticResource TextoSecundario}" />
            </VerticalStackLayout>
            <Button Text="Consultar cotações oficiais" Style="{StaticResource BotaoSecundario}" Command="{Binding ConsultaCotacoesCommand}" IsVisible="{Binding ExibirConsultaCotacoes}"
                    AutomationId="ConsultarCotacoes" SemanticProperties.Description="Consultar dólar fiscal da Receita Federal e cotação de referência do Banco Central" />
            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Secoes}">
                <VerticalStackLayout.Triggers><DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Ocupado}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></VerticalStackLayout.Triggers>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SecaoCamposMobile">
                        <Border>
                            <VerticalStackLayout Spacing="12">
                                <Button Text="{Binding Titulo}" Style="{StaticResource BotaoSecundario}" Clicked="AlternarSecao" SemanticProperties.Hint="Expande ou recolhe os campos desta seção" />
                                <VerticalStackLayout IsVisible="{Binding Expandida}" Spacing="14" BindableLayout.ItemsSource="{Binding Campos}" BindableLayout.ItemTemplate="{StaticResource ModeloCampo}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="20" BindableLayout.ItemsSource="{Binding Grades}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:GradeMobile">
                        <Border IsVisible="{Binding Visivel}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="{Binding Titulo}" Style="{StaticResource TituloSecao}" SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="{Binding Descricao}" Style="{StaticResource TextoSecundario}" />
                                <Button Text="{Binding RotuloGerar}" Style="{StaticResource BotaoSecundario}" Command="{Binding GerarCommand}" IsVisible="{Binding TemGerar}" SemanticProperties.Description="{Binding RotuloGerar}" />
                                <Button Text="{Binding RotuloAdicionar}" Style="{StaticResource BotaoSecundario}" Command="{Binding AdicionarCommand}" SemanticProperties.Description="{Binding RotuloAdicionar}" />
                                <Label Text="{Binding Aviso}" IsVisible="{Binding TemAviso}" Style="{StaticResource TextoSecundario}" />
                                <views:PaginadorLinhas x:Name="PaginadorTopo" BindingContext="{Binding Pagina}" />
                                <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Pagina.Exibidas}" IsVisible="{Binding TemLinhas}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LinhaGradeMobile">
                                            <VerticalStackLayout Spacing="10">
                                                <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Campos}" BindableLayout.ItemTemplate="{StaticResource ModeloCampo}" />
                                                <Button Text="{Binding Source={RelativeSource AncestorType={x:Type vm:GradeMobile}}, Path=RotuloRemover}" Style="{StaticResource BotaoLink}" HorizontalOptions="End"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GradeMobile}}, Path=RemoverCommand}" CommandParameter="{Binding .}"
                                                        SemanticProperties.Description="{Binding Titulo, StringFormat='Remover {0}'}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <views:PaginadorLinhas BindingContext="{Binding Pagina}" RolarAte="{x:Reference PaginadorTopo}" />
                            </VerticalStackLayout>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Source={RelativeSource AncestorType={x:Type vm:CalculadoraTrabalhistaViewModel}}, Path=Ocupado}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Border IsVisible="{Binding ExibirHistoricoFgts}">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Ocupado}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    </VerticalStackLayout.Triggers>
                    <Label Text="Depósitos históricos do FGTS" Style="{StaticResource TituloSecao}" />
                    <Label Text="Informe os depósitos devidos antes do mês do desligamento. Valores já digitados são preservados ao gerar os meses novamente." Style="{StaticResource TextoSecundario}" />
                    <Button Text="Gerar meses do contrato" Style="{StaticResource BotaoSecundario}" Command="{Binding GerarDepositosCommand}" AutomationId="GerarDepositosFgts" />
                    <Button Text="+ Mês" Style="{StaticResource BotaoSecundario}" Command="{Binding AdicionarDepositoCommand}" AutomationId="AdicionarDepositoFgts" />
                    <Label Text="{Binding AvisoHistorico}" Style="{StaticResource TextoSecundario}" />
                    <views:PaginadorLinhas x:Name="PaginadorDepositosTopo" BindingContext="{Binding PaginaDepositosFgts}" />
                    <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding PaginaDepositosFgts.Exibidas}" IsVisible="{Binding TemDepositosFgts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinhaDepositoFgtsMobile">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Competência" Style="{StaticResource RotuloCampo}" />
                                    <Border Style="{StaticResource CaixaCampo}"><views:EntradaPeriodoView Texto="{Binding Competencia}" Tipo="Competencia" Rotulo="Competência do depósito do FGTS" /></Border>
                                    <Label Text="Depósito (R$)" Style="{StaticResource RotuloCampo}" />
                                    <Border Style="{StaticResource CaixaCampo}"><Entry Text="{Binding Valor}" SemanticProperties.Description="Valor devido do depósito do FGTS" /></Border>
                                    <Button Text="Remover mês" Style="{StaticResource BotaoLink}" HorizontalOptions="End" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CalculadoraTrabalhistaViewModel}}, Path=RemoverDepositoCommand}" CommandParameter="{Binding .}" SemanticProperties.Description="Remover depósito do FGTS" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <views:PaginadorLinhas BindingContext="{Binding PaginaDepositosFgts}" RolarAte="{x:Reference PaginadorDepositosTopo}" />
                </VerticalStackLayout>
            </Border>
            <Border IsVisible="{Binding ExibirBeneficiosDetalhados}">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Ocupado}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    </VerticalStackLayout.Triggers>
                    <Label Text="Benefícios detalhados" Style="{StaticResource TituloSecao}" />
                    <Label Text="Até 30 benefícios opcionais. Informe custo e participação do empregado separadamente. Não repita valores do total agregado." Style="{StaticResource TextoSecundario}" />
                    <Button Text="+ Benefício" Style="{StaticResource BotaoSecundario}" Command="{Binding AdicionarBeneficioCommand}" AutomationId="AdicionarBeneficio" />
                    <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding BeneficiosDetalhados}" IsVisible="{Binding TemBeneficiosDetalhados}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinhaBeneficioMobile">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Descrição" Style="{StaticResource RotuloCampo}" />
                                    <Border Style="{StaticResource CaixaCampo}"><Entry Text="{Binding Descricao}" MaxLength="100" Keyboard="Text" SemanticProperties.Description="Descrição do benefício" /></Border>
                                    <Label Text="Custo mensal (R$)" Style="{StaticResource RotuloCampo}" />
                                    <Border Style="{StaticResource CaixaCampo}"><Entry Text="{Binding Custo}" SemanticProperties.Description="Custo mensal do benefício"><Entry.Behaviors><comportamentos:EntradaMonetariaBehavior /></Entry.Behaviors></Entry></Border>
                                    <Label Text="Participação do empregado (R$)" Style="{StaticResource RotuloCampo}" />
                                    <Border Style="{StaticResource CaixaCampo}"><Entry Text="{Binding Participacao}" SemanticProperties.Description="Participação do empregado no benefício"><Entry.Behaviors><comportamentos:EntradaMonetariaBehavior /></Entry.Behaviors></Entry></Border>
                                    <Button Text="Remover benefício" Style="{StaticResource BotaoLink}" HorizontalOptions="End" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CalculadoraTrabalhistaViewModel}}, Path=RemoverBeneficioCommand}" CommandParameter="{Binding .}" SemanticProperties.Description="Remover benefício detalhado" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Border IsVisible="{Binding ExibirLancamentosBancoHoras}">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Ocupado}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    </VerticalStackLayout.Triggers>
                    <Label Text="Lançamentos do ciclo" Style="{StaticResource TituloSecao}" />
                    <Label Text="De 1 a 500 lançamentos com data dentro do ciclo. Horas de relógio de 0:01 a 10:00; créditos até 2:00 por dia. As folgas compensam primeiro os créditos mais antigos." Style="{StaticResource TextoSecundario}" />
                    <Button Text="+ Lançamento" Style="{StaticResource BotaoSecundario}" Command="{Binding AdicionarLancamentoCommand}" AutomationId="AdicionarLancamentoBanco" />
                    <views:PaginadorLinhas x:Name="PaginadorLancamentosTopo" BindingContext="{Binding PaginaLancamentosBancoHoras}" />
                    <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding PaginaLancamentosBancoHoras.Exibidas}" IsVisible="{Binding TemLancamentosBancoHoras}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinhaLancamentoBancoHorasMobile">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Data (dd/mm/aaaa)" Style="{StaticResource RotuloCampo}" />
                                    <Border Style="{StaticResource CaixaCampo}"><views:EntradaPeriodoView Texto="{Binding Data}" Tipo="Data" Rotulo="Data do lançamento" /></Border>
                                    <Label Text="Tipo" Style="{StaticResource RotuloCampo}" />
                                    <Border Style="{StaticResource CaixaCampo}"><Picker ItemsSource="{Binding Tipos}" SelectedIndex="{Binding Tipo}" Title="Selecione" SemanticProperties.Description="Tipo do lançamento" /></Border>
                                    <Label Text="Horas (h:mm)" Style="{StaticResource RotuloCampo}" />
                                    <Border Style="{StaticResource CaixaCampo}"><Entry Text="{Binding Horas}" Placeholder="1:30" Keyboard="Text" MaxLength="5" SemanticProperties.Description="Horas do lançamento em horas e minutos" /></Border>
                                    <Label Text="Adicional do crédito (%, opcional)" Style="{StaticResource RotuloCampo}" IsVisible="{Binding EhCredito}" />
                                    <Border Style="{StaticResource CaixaCampo}" IsVisible="{Binding EhCredito}"><Entry Text="{Binding Adicional}" Placeholder="Vazio usa o adicional padrão" MaxLength="10" SemanticProperties.Description="Adicional próprio do crédito" /></Border>
                                    <Label Text="Descrição (opcional)" Style="{StaticResource RotuloCampo}" />
                                    <Border Style="{StaticResource CaixaCampo}"><Entry Text="{Binding Descricao}" MaxLength="100" Keyboard="Text" SemanticProperties.Description="Descrição do lançamento" /></Border>
                                    <Button Text="Remover lançamento" Style="{StaticResource BotaoLink}" HorizontalOptions="End" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CalculadoraTrabalhistaViewModel}}, Path=RemoverLancamentoCommand}" CommandParameter="{Binding .}" SemanticProperties.Description="Remover lançamento do banco de horas" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <views:PaginadorLinhas BindingContext="{Binding PaginaLancamentosBancoHoras}" RolarAte="{x:Reference PaginadorLancamentosTopo}" />
                </VerticalStackLayout>
            </Border>
            <Border IsVisible="{Binding TemQuitacaoBancoHoras}">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Ocupado}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    </VerticalStackLayout.Triggers>
                    <Label Text="Quitação do banco de horas" Style="{StaticResource TituloSecao}" />
                    <Label Text="{Binding QuitacaoBancoHorasTexto}" />
                    <Label Text="As parcelas entram como proventos com INSS, IRRF e FGTS. A data e o salário do banco foram copiados para o formulário." Style="{StaticResource TextoSecundario}" />
                    <HorizontalStackLayout Spacing="12">
                        <Switch IsToggled="{Binding QuitacaoConfirmada}" SemanticProperties.Description="Confirmo as incidências da quitação do banco de horas" />
                        <Label Text="Conferi as incidências" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Text="Descartar quitação" Style="{StaticResource BotaoSecundario}" Command="{Binding DescartarQuitacaoCommand}" SemanticProperties.Description="Descartar a quitação transferida do banco de horas" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding Mensagem}" IsVisible="{Binding TemMensagem}" TextColor="{AppThemeBinding Light={StaticResource ErroClaro}, Dark={StaticResource ErroEscuro}}" />
            <ActivityIndicator IsVisible="{Binding Ocupado}" IsRunning="{Binding Ocupado}" />
            <views:ResultadoSimulacaoView x:Name="Resultado" Demonstrativo="{Binding Demonstrativo}" CompartilharPdfCommand="{Binding CompartilharPdfCommand}" />
            <Button Text="Usar no holerite" Command="{Binding UsarNoHoleriteCommand}" IsVisible="{Binding PodeUsarNoHolerite}" AutomationId="UsarNoHolerite" SemanticProperties.Description="Abrir o holerite com a quitação do banco de horas" />
            <Button Text="Usar na rescisão" Command="{Binding UsarNaRescisaoCommand}" IsVisible="{Binding PodeUsarNaRescisao}" AutomationId="UsarNaRescisao" SemanticProperties.Description="Abrir a rescisão com a quitação do banco de horas" />
            <Button Text="Calcular o IR (RRA)" Command="{Binding CalcularRraCommand}" IsVisible="{Binding PodeCalcularRra}"
                    AutomationId="CalcularRra" SemanticProperties.Description="Levar as diferenças por competência para o cálculo de RRA" />
            <Button Text="Usar na rescisão" Command="{Binding LevarFgtsRescisaoCommand}" IsVisible="{Binding PodeLevarFgtsRescisao}"
                    AutomationId="LevarFgtsRescisao" SemanticProperties.Description="Levar depósitos históricos conferidos para a rescisão" />
            <Button Text="Usar no holerite" Command="{Binding JornadaParaHoleriteCommand}" IsVisible="{Binding PodeTransferirJornada}"
                    AutomationId="JornadaParaHolerite" SemanticProperties.Description="Levar horas e faltas do ponto para o holerite" />
            <Button Text="Usar nas horas extras" Command="{Binding JornadaParaHorasExtrasCommand}" IsVisible="{Binding PodeTransferirJornada}"
                    AutomationId="JornadaParaHorasExtras" SemanticProperties.Description="Levar horas do ponto para a calculadora de horas extras" />
            <Label Text="Simulação com valores estimados. Confira as premissas no demonstrativo e procure um profissional especializado para validar os valores." Style="{StaticResource TextoSecundario}" />
        </VerticalStackLayout>
    </ScrollView>
        <Border Grid.Row="1" Padding="16,8" StrokeShape="Rectangle">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button Text="Calcular" Command="{Binding CalcularCommand}" AutomationId="CalcularTrabalhista" />
                <Button Grid.Column="1" Text="Resultado" IsVisible="{Binding TemResultado}" Style="{StaticResource BotaoSecundario}" Clicked="IrAoResultado" AutomationId="IrAoResultado" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
