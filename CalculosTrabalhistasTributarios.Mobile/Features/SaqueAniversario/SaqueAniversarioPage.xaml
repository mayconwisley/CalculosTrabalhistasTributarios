<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Presentation.SaqueAniversario;assembly=CalculosTrabalhistasTributarios.Mobile.Presentation"
             xmlns:dto="clr-namespace:CalculosTrabalhistasTributarios.Application.DTOs;assembly=CalculosTrabalhistasTributarios.Application"
             xmlns:comportamentos="clr-namespace:CalculosTrabalhistasTributarios.Mobile.Comportamentos"
             x:Class="CalculosTrabalhistasTributarios.Mobile.Features.SaqueAniversario.SaqueAniversarioPage"
             x:DataType="vm:SaqueAniversarioViewModel"
             Title="Simulador FGTS">
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,28" Spacing="20" MaximumWidthRequest="640" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="10">
                <Border Padding="12,6" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Start"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark={StaticResource AcentoEscuro}}">
                    <Label Text="FGTS · SIMULAÇÃO LOCAL" FontSize="11" FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light={StaticResource TextoAcentoClaro}, Dark={StaticResource TextoAcentoEscuro}}" />
                </Border>
                <Label Text="Planeje seu&#10;saque-aniversário" FontSize="30" FontFamily="OpenSansSemibold" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Do extrato ao resultado, com memória de cálculo e um PDF pronto para compartilhar." Style="{StaticResource TextoSecundario}" FontSize="14" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Ocupado}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                </VerticalStackLayout.Triggers>
                <Border>
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="01  Seu saldo" Style="{StaticResource TituloSecao}" SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="Use os valores apresentados no extrato do FGTS." Style="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Saldo do extrato (R$)" Style="{StaticResource RotuloCampo}" />
                            <Border Style="{StaticResource CaixaCampo}">
                                <Entry Text="{Binding Saldo}" AutomationId="Saldo" SemanticProperties.Description="Saldo do extrato em reais">
                                    <Entry.Behaviors><comportamentos:EntradaMonetariaBehavior /></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Mês de aniversário" Style="{StaticResource RotuloCampo}" />
                            <Border Style="{StaticResource CaixaCampo}">
                                <Picker Title="Selecione o mês" ItemsSource="{Binding Meses}" SelectedIndex="{Binding IndiceMes}"
                                        AutomationId="MesAniversario" SemanticProperties.Description="Mês de aniversário" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border>
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="02  Ajustes do extrato" Style="{StaticResource TituloSecao}" SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="Sem bloqueios ou empréstimos? Mantenha os valores em 0,00." Style="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Garantia bloqueada (R$)" Style="{StaticResource RotuloCampo}" />
                            <Border Style="{StaticResource CaixaCampo}">
                                <Entry Text="{Binding GarantiaBloqueada}" AutomationId="Garantia" SemanticProperties.Description="Garantia bloqueada em reais">
                                    <Entry.Behaviors><comportamentos:EntradaMonetariaBehavior /></Entry.Behaviors>
                                </Entry>
                            </Border>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="O saldo informado já inclui essa garantia" Style="{StaticResource TextoSecundario}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding SaldoIncluiGarantia}" SemanticProperties.Description="Saldo do extrato já inclui a garantia bloqueada" />
                            </Grid>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Multa incluída no saldo (R$)" Style="{StaticResource RotuloCampo}" />
                            <Border Style="{StaticResource CaixaCampo}">
                                <Entry Text="{Binding MultaIncluida}" AutomationId="Multa" SemanticProperties.Description="Multa rescisória incluída no saldo em reais">
                                    <Entry.Behaviors><comportamentos:EntradaMonetariaBehavior /></Entry.Behaviors>
                                </Entry>
                            </Border>
                            <Label Text="A multa rescisória é excluída da base. Use 0,00 se não estiver incluída." Style="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Parcela anual cedida ao banco (R$)" Style="{StaticResource RotuloCampo}" />
                            <Border Style="{StaticResource CaixaCampo}">
                                <Entry Text="{Binding ParcelaComprometida}" AutomationId="Parcela" SemanticProperties.Description="Parcela deste saque comprometida com o banco em reais">
                                    <Entry.Behaviors><comportamentos:EntradaMonetariaBehavior /></Entry.Behaviors>
                                </Entry>
                            </Border>
                            <Label Text="Informe somente o repasse deste saque, não o total do empréstimo. Use 0,00 se não houver." Style="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Label IsVisible="{Binding TemMensagem}" Text="{Binding Mensagem}" TextColor="{AppThemeBinding Light={StaticResource ErroClaro}, Dark={StaticResource ErroEscuro}}" SemanticProperties.Description="Aviso da simulação">
            </Label>
            <Button Text="Calcular meu saque" Command="{Binding CalcularCommand}" AutomationId="Calcular" SemanticProperties.Description="Calcular saque-aniversário" />
            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" Color="{StaticResource Primaria}" />

            <VerticalStackLayout Spacing="18" IsVisible="{Binding TemResultado}">
                <Border StrokeThickness="0" Padding="24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource PrimariaProfunda}" Offset="0" />
                            <GradientStop Color="{StaticResource Primaria}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="SEU RESULTADO" TextColor="White" FontSize="11" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding Demonstrativo.RotuloResultado}" TextColor="White" FontSize="16" />
                        <Label Text="{Binding ResultadoFormatado}" TextColor="White" FontSize="36" FontFamily="OpenSansSemibold" SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{Binding Demonstrativo.Referencia}" TextColor="White" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Compartilhar PDF" Command="{Binding CompartilharPdfCommand}" AutomationId="CompartilharPdf" SemanticProperties.Description="Gerar PDF e escolher aplicativo para compartilhar" />
                <Label Text="Escolha WhatsApp, e-mail ou outro aplicativo instalado. O documento inclui a memória e as premissas da simulação." Style="{StaticResource TextoSecundario}" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Demonstrativo.Destaques}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:DestaqueDto">
                            <Border Padding="18">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Rotulo}" Style="{StaticResource TextoSecundario}" />
                                    <Label Text="{Binding Valor}" FontSize="21" FontFamily="OpenSansSemibold" />
                                    <Label Text="{Binding Complemento}" Style="{StaticResource TextoSecundario}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Border Padding="18,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Demonstrativo e memória" Style="{StaticResource RotuloCampo}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ExibirDetalhes}" AutomationId="ExibirDetalhes" SemanticProperties.Description="Mostrar demonstrativo e memória de cálculo" />
                    </Grid>
                </Border>
                <Border IsVisible="{Binding ExibirDetalhes}">
                    <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding Demonstrativo.RotuloProventos}" FontAttributes="Bold" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Demonstrativo.Proventos}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:VerbaDto">
                                <VerticalStackLayout Spacing="3" Padding="0,4">
                                    <Label Text="{Binding Descricao}" />
                                    <Label Text="{Binding Referencia}" />
                                    <Label Text="{Binding Valor, StringFormat='R$ {0:N2}'}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Descontos" FontAttributes="Bold" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Demonstrativo.Descontos}" BindableLayout.EmptyView="Sem descontos informados.">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:VerbaDto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Descricao}" />
                                    <Label Text="{Binding Referencia}" />
                                    <Label Text="{Binding Valor, StringFormat='R$ {0:N2}'}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding Demonstrativo.RotuloResultado}" FontAttributes="Bold" />
                    <Label Text="{Binding Demonstrativo.Resultado, StringFormat='R$ {0:N2}'}" FontSize="24" FontAttributes="Bold" />
                    <Label Text="Memória de cálculo" FontSize="20" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
                    <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Demonstrativo.Memoria}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:GrupoMemoriaDto">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                    <Label Text="{Binding Destaque}" />
                                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Formulas}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="dto:FormulaDto">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                                    <Label Text="{Binding Formula}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Premissas e limites" FontSize="20" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Demonstrativo.Observacoes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String"><Label Text="{Binding .}" /></DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <Border Padding="16" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark={StaticResource AcentoEscuro}}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Uma estimativa para orientar sua decisão" FontFamily="OpenSansSemibold" />
                    <Label Text="Cálculo simulado, com valores estimados. Procure um profissional especializado para apurar e validar os valores." Style="{StaticResource TextoSecundario}" />
                    <Label Text="Confirme a disponibilidade no aplicativo FGTS. Esta versão não salva histórico nem analisa nova antecipação." Style="{StaticResource TextoSecundario}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
