    <Color x:Key="FundoEscuro">#101828</Color>
    <Color x:Key="CartaoClaro">#FFFFFF</Color>
    <Color x:Key="CartaoEscuro">#182230</Color>
    <Color x:Key="TextoClaro">#101828</Color>
    <Color x:Key="TextoEscuro">#F9FAFB</Color>
    <Color x:Key="SecundarioClaro">#5D6679</Color>
    <Color x:Key="SecundarioEscuro">#A4ADBC</Color>
