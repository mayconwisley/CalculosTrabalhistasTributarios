    <Color x:Key="BordaEscura">#344054</Color>
    <Color x:Key="Primaria">#175CD3</Color>
    <Color x:Key="PrimariaEscura">#1570EF</Color>
    <Color x:Key="PrimariaProfunda">#1849A9</Color>
    <Color x:Key="AcentoClaro">#DBEAFE</Color>
    <Color x:Key="AcentoEscuro">#1E3A5F</Color>
