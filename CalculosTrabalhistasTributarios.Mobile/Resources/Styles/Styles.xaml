<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FundoClaro}, Dark={StaticResource FundoEscuro}}" />
    </Style>
    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource FundoClaro}, Dark={StaticResource FundoEscuro}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}" />
    </Style>
    <Style x:Key="RotuloBase" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource RotuloBase}" />
    <Style x:Key="TextoSecundario" TargetType="Label" BasedOn="{StaticResource RotuloBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecundarioClaro}, Dark={StaticResource SecundarioEscuro}}" />
    </Style>
    <Style x:Key="TituloSecao" TargetType="Label" BasedOn="{StaticResource RotuloBase}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style x:Key="RotuloCampo" TargetType="Label" BasedOn="{StaticResource RotuloBase}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="MinimumHeightRequest" Value="54" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="Keyboard" Value="Numeric" />
        <Setter Property="MaxLength" Value="24" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="MinimumHeightRequest" Value="54" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource SecundarioClaro}, Dark={StaticResource SecundarioEscuro}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="54" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primaria}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="CartaoBase" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CartaoClaro}, Dark={StaticResource CartaoEscuro}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BordaClara}, Dark={StaticResource BordaEscura}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
    </Style>
    <Style TargetType="Border" BasedOn="{StaticResource CartaoBase}" />
    <Style x:Key="CaixaCampo" TargetType="Border" BasedOn="{StaticResource CartaoBase}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FundoClaro}, Dark={StaticResource FundoEscuro}}" />
    </Style>
</ResourceDictionary>
