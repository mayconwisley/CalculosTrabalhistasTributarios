<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <SolidColorBrush x:Key="ErroCampoBrush" Color="{AppThemeBinding Light={StaticResource ErroClaro}, Dark={StaticResource ErroEscuro}}" />
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FundoClaro}, Dark={StaticResource FundoEscuro}}" />
    </Style>
    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource FundoClaro}, Dark={StaticResource FundoEscuro}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}" />
    </Style>
    <Style x:Key="RotuloBase" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource RotuloBase}" />
    <Style x:Key="TextoSecundario" TargetType="Label" BasedOn="{StaticResource RotuloBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecundarioClaro}, Dark={StaticResource SecundarioEscuro}}" />
    </Style>
    <Style x:Key="TextoErroCampo" TargetType="Label" BasedOn="{StaticResource TextoSecundario}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErroClaro}, Dark={StaticResource ErroEscuro}}" />
    </Style>
    <!-- Aviso do cálculo junto do botão: resume os campos destacados ou traz a regra que não cita campo. -->
    <Style x:Key="AvisoDoCalculo" TargetType="Label" BasedOn="{StaticResource TextoErroCampo}">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="TituloSecao" TargetType="Label" BasedOn="{StaticResource RotuloBase}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style x:Key="TituloPagina" TargetType="Label" BasedOn="{StaticResource RotuloBase}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>
    <Style x:Key="RotuloDestaque" TargetType="Label" BasedOn="{StaticResource RotuloBase}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoAcentoClaro}, Dark={StaticResource TextoAcentoEscuro}}" />
    </Style>
    <Style x:Key="RotuloCampo" TargetType="Label" BasedOn="{StaticResource RotuloBase}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="MinimumHeightRequest" Value="54" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="Keyboard" Value="Numeric" />
        <Setter Property="MaxLength" Value="24" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="MinimumHeightRequest" Value="54" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource SecundarioClaro}, Dark={StaticResource SecundarioEscuro}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="54" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primaria}, Dark={StaticResource PrimariaEscura}}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="BotaoFavorito" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoAcentoClaro}, Dark={StaticResource TextoAcentoEscuro}}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>
    <Style x:Key="BotaoLink" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoAcentoClaro}, Dark={StaticResource TextoAcentoEscuro}}" />
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>
    <Style x:Key="BotaoSecundario" TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark={StaticResource AcentoEscuro}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoAcentoClaro}, Dark={StaticResource TextoAcentoEscuro}}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="MarcadorPasso" TargetType="Border">
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark={StaticResource AcentoEscuro}}" />
    </Style>
    <Style x:Key="NumeroPasso" TargetType="Label" BasedOn="{StaticResource RotuloBase}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoAcentoClaro}, Dark={StaticResource TextoAcentoEscuro}}" />
    </Style>
    <Style x:Key="CartaoBase" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CartaoClaro}, Dark={StaticResource CartaoEscuro}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BordaClara}, Dark={StaticResource BordaEscura}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
    </Style>
    <Style TargetType="Border" BasedOn="{StaticResource CartaoBase}" />
    <Style x:Key="CaixaCampo" TargetType="Border" BasedOn="{StaticResource CartaoBase}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FundoClaro}, Dark={StaticResource FundoEscuro}}" />
    </Style>
    <Style x:Key="ItemRecente" TargetType="Border" BasedOn="{StaticResource CartaoBase}">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FundoClaro}, Dark={StaticResource FundoEscuro}}" />
    </Style>
</ResourceDictionary>
